{
  "name": "limitra-website",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "node scripts/copy-images.mjs && astro dev",
    "start": "node scripts/copy-images.mjs && astro dev",
    "build": "node scripts/copy-images.mjs && astro build",
    "deploy:vps": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-vps.ps1",
    "preview": "astro preview",
    "astro": "astro",
    "check:links": "node scripts/check-links.mjs",
    "check:news": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-daily-news.ps1",
    "indexnow": "node scripts/indexnow.mjs",
    "report:bots": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ai-bot-report.ps1",
    "sitemap": "node scripts/generate-sitemap.mjs"
  },
  "dependencies": {
    "astro": "^4.16.12"
  }
}
