---
import NewsArticle from '../../../components/NewsArticle.astro';
import newsList from '../../../data/news-id.json';
import { SCREEN_CATEGORY } from '../../../data/categories';

export function getStaticPaths() {
  return newsList
    .filter((item) => item.category === SCREEN_CATEGORY.id)
    .map((item) => ({
      params: { slug: item.slug },
      props: { news: item }
    }));
}

const { news } = Astro.props;
---

<NewsArticle news={news} lang="id" />
