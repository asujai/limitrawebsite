---
import Layout from '../../layouts/Layout.astro';

const actionGuides = [
  {
    slug: "instagram-reels-ve-kisa-videolarin-sonsuz-dongusunu-kirmak",
    title: "Instagram Reels ve Kısa Videoların Sonsuz Döngüsünü Kırmak",
    desc: "Değişken ödül mekanizması ve algoritmik dopamin döngüsü beyni neden saatlerce esir alır? Sonsuz kaydırmayı iradeye güvenmeden durdurmanın 5 somut adımı.",
    tag: "Sosyal Medya & Dopamin",
    readTime: "6 dk"
  },
  {
    slug: "ders-calisirken-ve-sinavlara-hazirlanirken-telefona-bakmamak-icin-tavizsiz-rehber",
    title: "Sınavlara ve Akademik Çalışmalara Odaklanırken Telefonu Bırakamayanlar İçin Tavizsiz Kılavuz",
    desc: "Büyük sınavlara ve akademik projelere hazırlanırken yaşanan 'bilişsel sızıntı' (Brain Drain) ve iradeye ihtiyaç bırakmayan çalışma ortamı protokolleri.",
    tag: "Akademik Başarı & Sınavlar",
    readTime: "6 dk"
  },
  {
    slug: "cocugum-tableti-ve-telefonu-birakmiyor-ebeveynler-icin-kavgasiz-ekran-siniri",
    title: "Çocuğum Tableti ve Telefonu Bırakmıyor: Ebeveynler İçin Çatışmasız ve Net Dijital Sınırlar",
    desc: "Ekran elinden alındığında yaşanan öfke nöbetlerinin nörobiyolojik sebebi (dopamin çöküşü) ve ebeveyni 'kötü polis' yapmadan kuralı sisteme devretmenin yolları.",
    tag: "Ebeveyn Denetimi & Aile",
    readTime: "6 dk"
  },
  {
    slug: "gece-yatakta-telefon-kaydirma-ve-intikam-ertelemesi-uykuyu-geri-kazanmak",
    title: "Gece Yatakta Telefon Kaydırma (İntikam Ertelemesi): Uykuyu Geri Kazanmanın Yolları",
    desc: "Gündüz saatlerinde kendine vakit ayıramayan zihnin gece uykudan çalarak ekrana sığınması psikolojisi ve melatonin üretimini koruyan katı kapanış protokolleri.",
