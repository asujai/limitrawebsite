---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import { SUPPORTED_LANGUAGES, type SupportedLang } from '../data/translations';
import { parsePath, buildUrl } from '../data/routes';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  lang?: SupportedLang;
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogImage = '/og-limitra.png'
} = Astro.props;

const pathname = Astro.url.pathname;

// URL'den dili otomatik belirleme (veya prop'tan alma)
const pathSegments = pathname.split('/').filter(Boolean);
const firstSegment = pathSegments[0] as SupportedLang;
const supportedLangs: SupportedLang[] = ['tr', 'en', 'es', 'fr', 'de', 'pt', 'it', 'ar', 'id', 'fil', 'th'];

const currentLang: SupportedLang = Astro.props.lang || (supportedLangs.includes(firstSegment) ? firstSegment : 'tr');
const isRtl = currentLang === 'ar';

// Erisilebilirlik baglantisi icin dile gore metin
const skipLabels: Record<SupportedLang, string> = {
  tr: 'İçeriğe geç',
  en: 'Skip to content',
  es: 'Ir al contenido',
  fr: 'Aller au contenu',
  de: 'Zum Inhalt springen',
  pt: 'Ir para o conteúdo',
  it: 'Vai al contenuto',
  ar: 'تخطي إلى المحتوى',
  id: 'Lewati ke konten',
  fil: 'Lumaktaw sa nilalaman',
  th: 'ข้ามไปยังเนื้อหา'
};
const skipLabel = skipLabels[currentLang] ?? skipLabels.en;

const baseUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(pathname, baseUrl);
const shareImage = new URL(ogImage, baseUrl);

// hreflang: yalnizca hedef dilde gercekten var olan sayfalar icin uretilir.
const { key: pageKey, slug: pageSlug } = parsePath(pathname);
const alternates = SUPPORTED_LANGUAGES
  .map((l) => ({ code: l.code, url: buildUrl(l.code, pageKey, pageSlug) }))
  .filter((a): a is { code: SupportedLang; url: string } => a.url !== null);
const defaultAlternate = alternates.find((a) => a.code === 'en') ?? alternates.find((a) => a.code === 'tr');

const pageTitle = title.includes('Limitra') ? title : `${title} | Limitra App Block`;
const pageOgTitle = ogTitle.includes('Limitra') ? ogTitle : `${ogTitle} | Limitra App Block`;
---

<!doctype html>
<html lang={currentLang} dir={isRtl ? 'rtl' : 'ltr'}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18366719669"></script>
    <script>
      // @ts-ignore
      window.dataLayer = window.dataLayer || [];
      // @ts-ignore
      function gtag(){dataLayer.push(arguments);}
      // @ts-ignore
      gtag('js', new Date());
      // @ts-ignore
      gtag('config', 'AW-18366719669');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#09162f" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700&display=swap" rel="stylesheet" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageOgTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={shareImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={pageOgTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={shareImage} />

    <!-- Alternate Hreflang SEO Tags -->
    {alternates.map((a) => (
      <link rel="alternate" hreflang={a.code} href={new URL(a.url, baseUrl).href} />
    ))}
    {defaultAlternate && (
      <link rel="alternate" hreflang="x-default" href={new URL(defaultAlternate.url, baseUrl).href} />
    )}
  </head>
  <body class={isRtl ? 'rtl-layout' : ''}>
    <a href="#main-content" class="skip-link">{skipLabel}</a>
    <Navigation currentLang={currentLang} />
    <main id="main-content">
      <slot />
    </main>
    <Footer currentLang={currentLang} />
  </body>
</html>

<style is:global>
  .rtl-layout {
    direction: rtl;
    text-align: right;
  }
</style>
