---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
}

const {
  title,
  description,
  ogTitle = title,
  ogDescription = description,
  ogImage = '/og-limitra.png'
} = Astro.props;

const isEn = Astro.url.pathname.startsWith('/en');
const lang = isEn ? 'en' : 'tr';
const baseUrl = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, baseUrl);
const shareImage = new URL(ogImage, baseUrl);
---

<!doctype html>
<html lang={lang}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18366719669"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'AW-18366719669');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Limitra</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#09162f" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@500;600;700&display=swap" rel="stylesheet" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${ogTitle} | Limitra`} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:locale" content={isEn ? 'en_US' : 'tr_TR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${ogTitle} | Limitra`} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={shareImage} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{isEn ? 'Skip to content' : 'İçeriğe geç'}</a>
    <Navigation />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
