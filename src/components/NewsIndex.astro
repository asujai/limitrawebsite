---
import Layout from '../layouts/Layout.astro';
import { type SupportedLang } from '../data/translations';
import { newsByLang } from '../data/routes';
import { newsUI } from '../data/news-ui';
import DualProductCTA from './DualProductCTA.astro';

interface Props {
  lang?: SupportedLang;
}

const { lang = 'tr' } = Astro.props;
const ui = newsUI[lang] || newsUI.en;
const rawNewsList = newsByLang[lang] || newsByLang.en;

// Dünya Basını yalnızca küresel haberler, meclis kararları ve bilimsel araştırmaları içerir.
// 'Ekran Süresi Kontrolü' uygulamalı rehberleri ayrı bir ana başlık altındadır (IDs 57-76 ve 88-97).
const newsList = rawNewsList.filter(n => {
  const idNum = parseInt(n.id, 10);
  return (idNum < 57 || idNum > 76) && (idNum < 88 || idNum > 97);
});

const allCategory = ui.index.allCategory;
const categories = [allCategory, ...Array.from(new Set(newsList.map(n => n.category)))];

const featuredNews = newsList.find(n => n.featured) || newsList[0];
const regularNews = newsList.filter(n => n.id !== featuredNews.id);

const homeUrl = lang === 'tr' ? '/' : `/${lang}`;
const articleUrl = (slug: string) => lang === 'tr' ? `/haberler/${slug}` : `/${lang}/news/${slug}`;
---

<Layout 
  title={ui.index.pageTitle}
  description={ui.index.pageDesc}
  lang={lang}
>
  <section class="news-portal">
    <div class="container">
      <header class="portal-header">
        <a href={homeUrl} class="back-link">{ui.index.backHome}</a>
        <div class="header-badge">
          <span class="pulse-dot"></span>
          <span>{ui.index.badge}</span>
        </div>
        <h1>{ui.index.title}</h1>
        <p class="subtitle">
          {ui.index.subtitle}
        </p>
      </header>

      <!-- Category Filter Tabs -->
      <div class="category-nav" role="tablist" aria-label="News categories">
        {categories.map((cat, index) => (
          <button 
            type="button" 
            class:list={['cat-btn', { active: index === 0 }]} 
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Featured Story -->
      {featuredNews && (
        <article class="featured-card" data-card-category={featuredNews.category}>
          <div class="featured-content">
            <div class="card-meta">
              <span class="cat-pill">{featuredNews.category}</span>
              <span class="date">{featuredNews.date}</span>
              <span class="read-time">{featuredNews.readTime} {ui.index.readTimeSuffix}</span>
            </div>
            <h2>
              <a href={articleUrl(featuredNews.slug)}>{featuredNews.title}</a>
            </h2>
            <p class="summary">{featuredNews.summary}</p>
            <div class="card-footer">
              <span class="source">
                <strong>{ui.index.sourceLabel}</strong> {featuredNews.source}
              </span>
              <a href={articleUrl(featuredNews.slug)} class="read-btn">
                <span>{ui.index.readFullStory}</span>
                <span aria-hidden="true" class="arrow">&rarr;</span>
              </a>
            </div>
          </div>
        </article>
      )}

      <!-- News Grid -->
      <div class="news-grid" id="newsGrid">
        {regularNews.map((item) => (
          <article class="news-card" data-card-category={item.category}>
            <div class="card-meta">
              <span class="cat-pill">{item.category}</span>
              <span class="date">{item.date}</span>
            </div>
            <h3>
              <a href={articleUrl(item.slug)}>{item.title}</a>
            </h3>
            <p class="summary">{item.summary}</p>
            <div class="card-footer">
              <span class="source-tag" title={item.source}>{item.source}</span>
              <a href={articleUrl(item.slug)} class="read-link">
                <span>{ui.index.read}</span>
                <span aria-hidden="true" class="arrow">&rarr;</span>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Dual Product CTA Box -->
      <DualProductCTA lang={lang} />
    </div>
  </section>
</Layout>

<script>
  function setupCategoryFiltering() {
    const buttons = document.querySelectorAll('.cat-btn');
    const cards = document.querySelectorAll('[data-card-category]');
    if (!buttons.length) return;
    const allCategory = buttons[0]?.getAttribute('data-category') || '';

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.classList.remove('active'));
        btn.classList.add('active');

        const selected = btn.getAttribute('data-category');

        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-card-category');
          if (selected === allCategory || cardCat === selected) {
            (card as HTMLElement).style.display = '';
          } else {
            (card as HTMLElement).style.display = 'none';
          }
        });
      });
    });
  }

  document.addEventListener('astro:page-load', setupCategoryFiltering);
  setupCategoryFiltering();
</script>

<style>
  .news-portal {
    padding-top: var(--space-8);
    padding-bottom: var(--space-16);
  }

  .portal-header {
    max-width: 860px;
    margin-bottom: var(--space-8);
  }

  .back-link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: var(--space-4);
    font-weight: 600;
  }

  .back-link:hover {
    color: var(--accent);
  }

  .header-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.85rem;
    background: rgba(38, 103, 245, 0.08);
    border: 1px solid var(--accent-border);
    border-radius: var(--radius-full);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-bottom: var(--space-3);
  }

  .pulse-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--coral);
    box-shadow: 0 0 0 0 rgba(255, 107, 88, 0.7);
    animation: pulse 1.8s infinite;
  }

  @keyframes pulse {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(255, 107, 88, 0.7);
    }
    70% {
      transform: scale(1);
      box-shadow: 0 0 0 6px rgba(255, 107, 88, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(255, 107, 88, 0);
    }
  }

  .portal-header h1 {
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    margin-bottom: var(--space-4);
    line-height: 1.15;
  }

  .subtitle {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0;
  }

  /* Category Nav */
  .category-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: var(--space-8) 0 var(--space-8) 0;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-color);
  }

  .cat-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.55rem 1.15rem;
    background: white;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .cat-btn:hover {
    border-color: var(--accent-border);
    color: var(--accent);
    background: var(--accent-soft);
  }

  .cat-btn.active {
    background: var(--surface-dark);
    color: white;
    border-color: var(--surface-dark);
    box-shadow: 0 4px 14px rgba(9, 22, 47, 0.15);
  }

  /* Featured Card */
  .featured-card {
    background: linear-gradient(135deg, #09162f 0%, #152c59 100%);
    border-radius: var(--radius-lg);
    padding: clamp(2rem, 4vw, 3.2rem);
    color: white;
    margin-bottom: var(--space-12);
    position: relative;
    overflow: hidden;
    box-shadow: 0 20px 50px rgba(9, 22, 47, 0.2);
  }

  .featured-card::after {
    content: '';
    position: absolute;
    top: -8rem;
    inset-inline-end: -8rem;
    width: 22rem;
    height: 22rem;
    background: radial-gradient(circle, rgba(38, 103, 245, 0.35), transparent 70%);
    border-radius: 50%;
    pointer-events: none;
  }

  .featured-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
  }

  .card-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: var(--space-4);
    font-size: 0.8rem;
  }

  .cat-pill {
    display: inline-block;
    padding: 0.3rem 0.75rem;
    border-radius: var(--radius-full);
    background: var(--accent);
    color: white;
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .featured-card .date,
  .featured-card .read-time {
    color: #a2b4d6;
    font-weight: 500;
  }

  .featured-card h2 {
    font-size: clamp(1.6rem, 3.2vw, 2.4rem);
    margin: 0 0 var(--space-4) 0;
    line-height: 1.25;
  }

  .featured-card h2 a {
    color: white;
    text-decoration: none;
  }

  .featured-card h2 a:hover {
    color: var(--accent-light);
  }

  .featured-card .summary {
    color: #d1dced;
    font-size: 1.05rem;
    line-height: 1.65;
    margin-bottom: var(--space-6);
  }

  .featured-card .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }

  .featured-card .source {
    color: #9cb1d4;
    font-size: 0.88rem;
  }

  .read-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1.3rem;
    min-height: 44px;
    background: white;
    color: var(--surface-dark);
    font-weight: 700;
    font-size: 0.88rem;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
  }

  .read-btn .arrow {
    display: inline-block;
    transition: transform 0.2s cubic-bezier(0.2, 0, 0, 1);
    will-change: transform;
  }

  .read-btn:hover {
    background: var(--accent-light);
    color: white;
    box-shadow: 0 4px 14px rgba(45, 91, 227, 0.35);
  }

  .read-btn:hover .arrow,
  .featured-card:hover .read-btn .arrow {
    transform: translateX(4px);
  }

  /* Grid List */
  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.6rem;
    margin-bottom: var(--space-16);
  }

  .news-card {
    position: relative;
    background: white;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    padding: 1.6rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.25s cubic-bezier(0.2, 0, 0, 1), box-shadow 0.25s cubic-bezier(0.2, 0, 0, 1), border-color 0.25s ease;
    will-change: transform;
  }

  /* Buffer pseudo-element to prevent translateY mouseleave oscillation on card edges */
  .news-card::after {
    content: '';
    position: absolute;
    inset: -4px 0 -8px 0;
    pointer-events: none;
    z-index: 0;
  }

  .news-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-sm);
    border-color: var(--accent-border);
  }

  .news-card:hover::after {
    pointer-events: auto;
  }

  .news-card > * {
    position: relative;
    z-index: 1;
  }

  .news-card .cat-pill {
    background: var(--accent-soft);
    color: var(--accent);
    border: 1px solid var(--accent-border);
  }

  .news-card .date {
    color: var(--text-muted);
    font-size: 0.8rem;
  }

  .news-card h3 {
    margin: 0.8rem 0 0.6rem 0;
    font-size: 1.25rem;
    line-height: 1.35;
  }

  .news-card h3 a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .news-card h3 a:hover {
    color: var(--accent);
  }

  .news-card .summary {
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.55;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .news-card .card-footer {
    border-top: 1px solid var(--border-soft);
    padding-top: 0.85rem;
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: nowrap;
    min-height: 52px;
  }

  .source-tag {
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 600;
    flex: 1;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.4;
  }

  .read-link {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent);
    font-size: 0.88rem;
    font-weight: 700;
    min-height: 44px;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .read-link .arrow {
    display: inline-block;
    transition: transform 0.2s cubic-bezier(0.2, 0, 0, 1);
    will-change: transform;
  }

  .read-link:hover {
    color: var(--accent-deep);
    background-color: var(--accent-soft);
  }

  .read-link:hover .arrow,
  .news-card:hover .read-link .arrow {
    transform: translateX(4px);
  }

</style>
