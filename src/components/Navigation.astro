---
import { translations, SUPPORTED_LANGUAGES, type SupportedLang } from '../data/translations';
import { parsePath, resolveUrl, routes } from '../data/routes';

interface Props {
  currentLang?: SupportedLang;
}

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const pathSegments = pathname.split('/').filter(Boolean);
const firstSegment = pathSegments[0] as SupportedLang;

const currentLang: SupportedLang = Astro.props.currentLang || (
  SUPPORTED_LANGUAGES.some(l => l.code === firstSegment) ? firstSegment : 'tr'
);

const t = translations[currentLang] || translations.en;

// Mevcut sayfanın dil-bağımsız kimliği (hangi sayfa tipi + slug)
const { key: pageKey, slug: pageSlug } = parsePath(pathname);

// Dil değiştirici: hedef dilde sayfa yoksa İngilizce sürüme, o da yoksa
// dilin ana sayfasına düşer. Böylece hiçbir seçim 404 üretmez.
const getLangUrl = (targetLang: SupportedLang) => resolveUrl(targetLang, pageKey, pageSlug);

const r = routes(currentLang);
const homeHref = r.home;

const links = [
  { href: r.home, label: t.nav.home },
  { href: r.howItWorks, label: t.nav.howItWorks },
  { href: r.news, label: t.nav.news },
  { href: r.guides, label: t.nav.guides },
  { href: r.faq, label: t.nav.faq }
];

const isCurrent = (href: string) => pathname === href || (href !== '/' && href !== `/${currentLang}` && pathname.startsWith(href));
// Mobil menü düğmesi için dile göre etiket
const menuLabels: Record<SupportedLang, string> = {
  tr: 'Menüyü aç/kapat',
  en: 'Toggle menu',
  es: 'Abrir/cerrar menú',
  fr: 'Ouvrir/fermer le menu',
  de: 'Menü öffnen/schließen',
  pt: 'Abrir/fechar menu',
  it: 'Apri/chiudi menu',
  ar: 'فتح/إغلاق القائمة',
  id: 'Buka/tutup menu',
  fil: 'Buksan/isara ang menu',
  th: 'เปิด/ปิดเมนู'
};
const menuLabel = menuLabels[currentLang] ?? menuLabels.en;

const currentLangObj = SUPPORTED_LANGUAGES.find(l => l.code === currentLang) || SUPPORTED_LANGUAGES[0];
---

<header class="site-header" data-site-header>
  <div class="container nav-container">
    <a href={homeHref} class="brand" aria-label={`Limitra App Block ${t.nav.home}`}>
      <img src="/logo.png" alt="Limitra App Block Logo" class="brand-logo" width="36" height="36" />
      <span class="brand-text">Limitra <span class="brand-badge">App Block</span></span>
    </a>

    <nav class="nav" id="primary-navigation" aria-label={t.nav.home}>
      <ul class="nav-list">
        {links.map((link) => (
          <li>
            <a href={link.href} class="nav-link" aria-current={isCurrent(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
        <li class="mobile-nav-cta">
          <a href="https://play.google.com/store/apps/details?id=com.gardiyan.app" target="_blank" rel="noopener noreferrer" class="mobile-download-link">
            <span>{t.nav.getApp}</span>
            <span aria-hidden="true">↗</span>
          </a>
        </li>
      </ul>
    </nav>

    <div class="nav-actions">
      <!-- Multilingual Dropdown -->
      <div class="lang-dropdown" data-lang-dropdown>
        <button type="button" class="lang-dropdown-btn" aria-haspopup="true" aria-expanded="false" aria-label={t.nav.language}>
          <span class="lang-flag">{currentLangObj.flag}</span>
          <span class="lang-code">{currentLangObj.code.toUpperCase()}</span>
          <svg class="dropdown-icon" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
            <polyline points="6 9 12 15 18 9"></polyline>
          </svg>
        </button>
        <div class="lang-menu" role="menu">
          {SUPPORTED_LANGUAGES.map((lang) => (
            <a 
              href={getLangUrl(lang.code)} 
              class={`lang-menu-item ${lang.code === currentLang ? 'active' : ''}`}
              role="menuitem"
            >
              <span class="lang-flag">{lang.flag}</span>
              <span class="lang-name">{lang.nativeName}</span>
              <span class="lang-code-tag">{lang.code.toUpperCase()}</span>
            </a>
          ))}
        </div>
      </div>

      <a href="https://play.google.com/store/apps/details?id=com.gardiyan.app" target="_blank" rel="noopener noreferrer" class="download-link">
        <span>{t.nav.getApp}</span>
        <span aria-hidden="true">↗</span>
      </a>

      <button
        type="button"
        class="menu-toggle"
        data-menu-toggle
        aria-controls="primary-navigation"
        aria-expanded="false"
        aria-label={menuLabel}
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle
  const header = document.querySelector('[data-site-header]');
  const toggle = document.querySelector('[data-menu-toggle]');
  const nav = document.getElementById('primary-navigation');

  function closeMobileMenu() {
    if (header && toggle) {
      header.classList.remove('nav-open');
      document.body.classList.remove('nav-open');
      toggle.setAttribute('aria-expanded', 'false');
    }
  }

  if (toggle && header && nav) {
    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      const isOpen = header.classList.toggle('nav-open');
      document.body.classList.toggle('nav-open', isOpen);
      toggle.setAttribute('aria-expanded', String(isOpen));
    });

    nav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', closeMobileMenu);
    });

    // Close on click outside header
    document.addEventListener('click', (e) => {
      if (header.classList.contains('nav-open') && !header.contains(e.target as Node)) {
        closeMobileMenu();
      }
    });

    // Close on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('nav-open')) {
        closeMobileMenu();
      }
    });
  }

  // Language Dropdown behavior
  const dropdown = document.querySelector('[data-lang-dropdown]');
  if (dropdown) {
    const btn = dropdown.querySelector('.lang-dropdown-btn');
    const menu = dropdown.querySelector('.lang-menu');
    
    if (btn && menu) {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = dropdown.classList.toggle('open');
        btn.setAttribute('aria-expanded', String(isOpen));
      });

      document.addEventListener('click', (e) => {
        if (!dropdown.contains(e.target as Node)) {
          dropdown.classList.remove('open');
          btn.setAttribute('aria-expanded', 'false');
        }
      });
    }
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    transition: all 0.2s ease;
  }

  .nav-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.5rem;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    font-weight: 700;
    color: var(--color-text-primary, #09162f);
    font-size: 1.15rem;
    font-family: var(--font-heading, inherit);
    letter-spacing: -0.01em;
    flex-shrink: 0;
    white-space: nowrap;
  }

  /* Acik zeminli ust bar: marka metni koyu */
  .brand-text {
    color: #09162f;
  }

  .brand-logo {
    border-radius: 8px;
    object-fit: cover;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
  }

  .brand-badge {
    font-size: 0.72rem;
    font-weight: 600;
    background: #eef2ff;
    color: #4338ca;
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
    border: 1px solid rgba(67, 56, 202, 0.15);
    margin-inline-start: 0.2rem;
    white-space: nowrap;
  }

  .nav-list {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
  }

  .mobile-nav-cta {
    display: none;
  }

  .nav-link {
    text-decoration: none;
    color: var(--color-text-secondary, #475569);
    font-weight: 500;
    font-size: 0.95rem;
    transition: color 0.2s ease;
    position: relative;
    padding: 0.4rem 0;
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--color-primary, #09162f);
  }

  .nav-link[aria-current='page']::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--color-primary, #09162f);
    border-radius: 2px;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-shrink: 0;
  }

  /* Multilingual Dropdown */
  .lang-dropdown {
    position: relative;
  }

  .lang-dropdown-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: #f8fafc;
    border: 1px solid rgba(15, 23, 42, 0.12);
    border-radius: 9999px;
    padding: 0.45rem 0.75rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #1e293b;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .lang-dropdown-btn:hover {
    background: #f1f5f9;
    border-color: rgba(15, 23, 42, 0.25);
  }

  .lang-flag {
    font-size: 1rem;
    line-height: 1;
  }

  .dropdown-icon {
    transition: transform 0.2s ease;
    color: #64748b;
  }

  .lang-dropdown.open .dropdown-icon {
    transform: rotate(180deg);
  }

  .lang-menu {
    position: absolute;
    top: calc(100% + 8px);
    inset-inline-end: 0;
    background: #ffffff;
    border-radius: 12px;
    box-shadow: 0 12px 32px rgba(15, 23, 42, 0.16), 0 2px 6px rgba(15, 23, 42, 0.06);
    border: 1px solid rgba(15, 23, 42, 0.08);
    padding: 0.4rem;
    min-width: 170px;
    display: none;
    flex-direction: column;
    gap: 0.15rem;
    z-index: 200;
    max-height: 380px;
    overflow-y: auto;
  }

  .lang-dropdown.open .lang-menu {
    display: flex;
  }

  .lang-menu-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.65rem;
    border-radius: 8px;
    text-decoration: none;
    color: #334155;
    font-size: 0.88rem;
    font-weight: 500;
    transition: background 0.15s ease;
  }

  .lang-menu-item:hover {
    background: #f1f5f9;
    color: #0f172a;
  }

  .lang-menu-item.active {
    background: #eef2ff;
    color: #4338ca;
    font-weight: 600;
  }

  .lang-code-tag {
    margin-inline-start: auto;
    font-size: 0.72rem;
    color: #94a3b8;
    font-weight: 600;
  }

  .download-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--color-primary, #09162f);
    color: #ffffff;
    padding: 0.6rem 1.15rem;
    border-radius: 9999px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .download-link:hover {
    opacity: 0.92;
    transform: translateY(-1px);
  }

  .menu-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    margin-inline-start: 0;
  }

  .menu-toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-primary, #09162f);
    border-radius: 2px;
    transition: transform 0.25s ease, opacity 0.2s ease;
  }

  /* Hamburger to X animasyonu */
  .site-header.nav-open .menu-toggle span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .site-header.nav-open .menu-toggle span:nth-child(2) {
    opacity: 0;
  }
  .site-header.nav-open .menu-toggle span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  @media (max-width: 900px) {
    .nav-container {
      min-height: 3.75rem;
      gap: 0.75rem;
    }

    .nav-list {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    .nav-actions .download-link {
      display: none;
    }

    .lang-dropdown-btn {
      padding: 0.35rem 0.55rem;
      font-size: 0.8rem;
    }

    .site-header.nav-open .nav-list {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #ffffff;
      padding: 1rem 1.5rem 1.5rem;
      border-bottom: 1px solid rgba(15, 23, 42, 0.1);
      box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
      gap: 0.25rem;
      max-height: calc(100dvh - 4rem);
      overflow-y: auto;
    }

    .site-header.nav-open .nav-list li {
      width: 100%;
    }

    .site-header.nav-open .nav-link {
      display: flex;
      align-items: center;
      width: 100%;
      min-height: 44px;
      padding: 0.6rem 0;
      font-size: 1.05rem;
    }

    .mobile-nav-cta {
      display: block;
      width: 100%;
      margin-top: 0.75rem;
      padding-top: 0.75rem;
      border-top: 1px solid rgba(15, 23, 42, 0.08);
    }

    .mobile-download-link {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      width: 100%;
      min-height: 44px;
      background: var(--color-primary, #09162f);
      color: #ffffff;
      padding: 0.75rem 1.25rem;
      border-radius: 9999px;
      font-size: 0.95rem;
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .mobile-download-link:hover {
      opacity: 0.92;
    }
  }
</style>
