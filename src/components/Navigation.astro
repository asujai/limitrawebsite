---
const currentUrl = Astro.url.pathname.replace(/\/$/, '') || '/';
const isEn = currentUrl === '/en' || currentUrl.startsWith('/en/');

let toggleLanguageUrl = '/';
if (isEn) {
  if (currentUrl === '/en/news') {
    toggleLanguageUrl = '/haberler';
  } else if (currentUrl.startsWith('/en/news/')) {
    toggleLanguageUrl = '/haberler';
  } else {
    toggleLanguageUrl = currentUrl.replace(/^\/en/, '') || '/';
  }
} else {
  if (currentUrl === '/haberler') {
    toggleLanguageUrl = '/en/news';
  } else if (currentUrl.startsWith('/haberler/')) {
    toggleLanguageUrl = '/en/news';
  } else {
    toggleLanguageUrl = `/en${currentUrl === '/' ? '' : currentUrl}`;
  }
}

const links = [
  { href: isEn ? '/en' : '/', label: isEn ? 'Home' : 'Ana Sayfa' },
  { href: isEn ? '/en/limitra' : '/limitra', label: isEn ? 'How it works' : 'Nasıl çalışır?' },
  { href: isEn ? '/en/news' : '/haberler', label: isEn ? 'Global News' : 'Dünya Basını' },
  { href: isEn ? '/en/bilgi-merkezi' : '/bilgi-merkezi', label: isEn ? 'Guides' : 'Rehberler' },
  { href: isEn ? '/en/sss' : '/sss', label: isEn ? 'FAQ' : 'SSS' }
];

const isCurrent = (href: string) => currentUrl === href || (href !== '/' && href !== '/en' && currentUrl.startsWith(href));
---

<header class="site-header" data-site-header>
  <div class="container nav-container">
    <a href={isEn ? '/en' : '/'} class="brand" aria-label={isEn ? 'Limitra App Block home' : 'Limitra App Block ana sayfa'}>
      <img src="/logo.jpg" alt="Limitra App Block Logo" class="brand-logo" width="36" height="36" />
      <span class="brand-text">Limitra <span class="brand-badge">App Block</span></span>
    </a>

    <nav class="nav" id="primary-navigation" aria-label={isEn ? 'Primary navigation' : 'Ana menü'}>
      <ul class="nav-list">
        {links.map((link) => (
          <li>
            <a href={link.href} class="nav-link" aria-current={isCurrent(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="nav-actions">
      <a href={toggleLanguageUrl} class="lang-switch" aria-label={isEn ? 'Türkçe diline geç' : 'Switch to English'}>
        {isEn ? 'TR' : 'EN'}
      </a>
      <a href="https://play.google.com/store/apps/details?id=com.gardiyan.app" target="_blank" rel="noopener noreferrer" class="download-link">
        <span>{isEn ? 'Get the app' : 'Uygulamayı indir'}</span>
        <span aria-hidden="true">↗</span>
      </a>
      <button class="menu-toggle" type="button" aria-label={isEn ? 'Open menu' : 'Menüyü aç'} aria-expanded="false" aria-controls="primary-navigation">
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>

<script>
  function initializeNavigation() {
    const header = document.querySelector('[data-site-header]');
    const toggle = header?.querySelector('.menu-toggle');
    const nav = header?.querySelector('.nav');
    if (!(toggle instanceof HTMLButtonElement) || !(nav instanceof HTMLElement)) return;
    if (toggle.dataset.ready === 'true') return;
    toggle.dataset.ready = 'true';

    const closeMenu = () => {
      toggle.setAttribute('aria-expanded', 'false');
      nav.classList.remove('is-open');
      document.body.classList.remove('nav-open');
    };

    toggle.addEventListener('click', () => {
      const willOpen = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(willOpen));
      nav.classList.toggle('is-open', willOpen);
      document.body.classList.toggle('nav-open', willOpen);
    });

    nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closeMenu();
    });
    window.addEventListener('resize', () => {
      if (window.innerWidth > 900) closeMenu();
    });
  }

  document.addEventListener('astro:page-load', initializeNavigation);
  initializeNavigation();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    border-bottom: 1px solid rgba(215, 223, 236, .78);
    background: rgba(247, 248, 252, .84);
    backdrop-filter: blur(18px) saturate(150%);
  }

  .nav-container {
    display: flex;
    min-height: 4.8rem;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: .72rem;
    color: #000000;
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 800;
    letter-spacing: -.03em;
    text-decoration: none;
  }

  .brand:hover {
    color: #000000;
  }

  .brand-logo {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: .65rem;
    object-fit: cover;
    box-shadow: 0 4px 14px rgba(9, 22, 47, 0.14);
    border: 1px solid rgba(0, 0, 0, 0.08);
  }

  .brand-text {
    color: #000000 !important;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .brand-badge {
    display: inline-block;
    font-size: 0.62rem;
    font-weight: 800;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-full);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    vertical-align: middle;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: .2rem;
    list-style: none;
  }

  .nav-link {
    display: block;
    border-radius: var(--radius-full);
    padding: .58rem .82rem;
    color: var(--text-secondary);
    font-size: .88rem;
    font-weight: 600;
  }

  .nav-link:hover,
  .nav-link[aria-current='page'] {
    background: white;
    color: var(--text-primary);
    box-shadow: 0 5px 15px rgba(30, 50, 88, .05);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: .65rem;
  }

  .lang-switch {
    display: grid;
    width: 2.45rem;
    height: 2.45rem;
    place-items: center;
    border: 1px solid var(--border-color);
    border-radius: 50%;
    color: var(--text-primary);
    font-size: .72rem;
    font-weight: 800;
  }

  .lang-switch:hover {
    border-color: var(--accent-border);
    background: var(--accent-soft);
    color: var(--accent);
  }

  .download-link {
    display: inline-flex;
    min-height: 2.7rem;
    align-items: center;
    gap: .5rem;
    border-radius: var(--radius-full);
    padding: .62rem 1rem;
    background: var(--surface-dark);
    color: white;
    font-size: .82rem;
    font-weight: 700;
  }

  .download-link:hover {
    transform: translateY(-1px);
    background: var(--accent);
    color: white;
  }

  .menu-toggle {
    display: none;
    width: 2.7rem;
    height: 2.7rem;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: .38rem;
    border: 1px solid var(--border-color);
    border-radius: 50%;
    background: white;
    cursor: pointer;
  }

  .menu-toggle span {
    width: 1rem;
    height: 2px;
    border-radius: 2px;
    background: var(--text-primary);
    transition: transform .2s ease;
  }

  .menu-toggle[aria-expanded='true'] span:first-child {
    transform: translateY(4px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  @media (max-width: 900px) {
    .nav {
      position: fixed;
      top: 4.8rem;
      right: 0;
      left: 0;
      display: none;
      height: calc(100dvh - 4.8rem);
      border-top: 1px solid var(--border-color);
      background: rgba(247, 248, 252, .98);
      padding: 1.25rem;
    }

    .nav.is-open {
      display: block;
    }

    .nav-list {
      align-items: stretch;
      flex-direction: column;
      gap: .35rem;
    }

    .nav-link {
      padding: 1rem;
      background: white;
      font-size: 1rem;
    }

    .menu-toggle {
      display: flex;
    }
  }

  @media (max-width: 560px) {
    .download-link {
      display: none;
    }

    .nav-container {
      gap: .75rem;
    }
  }
</style>
