const c = copy[lang] || copy.en;
---

<div class="dual-cta-container">
  <div class="dual-cta-card">
    <div class="cta-header">
      <span class="cta-kicker">{c.kicker}</span>
      <h2>{c.title}</h2>
      <p class="cta-subtitle">{c.desc}</p>
    </div>

    <div class="cta-grid">
      <!-- Product 1: Limitra Social -->
      <div class="product-box social-box">
        <div class="box-top">
          <span class="product-badge social-badge">{c.social.badge}</span>
          <h3>{c.social.title}</h3>
          <p class="product-desc">{c.social.desc}</p>
        </div>
        <div class="box-bottom">
          <a href={SOCIAL_STORE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-full">
            <svg class="play-icon" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
              <path d="M6 3.8v16.4c0 .8.9 1.3 1.6.9l13-8.2c.6-.4.6-1.4 0-1.8l-13-8.2C6.9 2.5 6 3 6 3.8Z" />
            </svg>
            <span>{c.social.cta}</span>
          </a>
        </div>
      </div>

      <!-- Product 2: Limitra App Block -->
      <div class="product-box block-box">
        <div class="box-top">
          <span class="product-badge block-badge">{c.block.badge}</span>
          <h3>{c.block.title}</h3>
          <p class="product-desc">{c.block.desc}</p>
        </div>
        <div class="box-bottom">
          <a href={BLOCK_STORE_URL} target="_blank" rel="noopener noreferrer" class="btn btn-gold-outline btn-full">
            <span>{c.block.cta} ↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .dual-cta-container {
    width: 100%;
    margin-top: var(--space-12);
  }

  .dual-cta-card {
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, #eef3ff 0%, #f7f9fd 100%);
    border: 1px solid var(--accent-border);
    padding: clamp(2rem, 4vw, 3.25rem);
    box-shadow: 0 4px 20px rgba(45, 91, 227, 0.04);
  }

  .cta-header {
    text-align: center;
    max-width: 44rem;
    margin: 0 auto 2.25rem;
  }

  .cta-kicker {
    display: inline-block;
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 0.6rem;
  }

  .cta-header h2 {
    margin: 0 0 0.8rem 0;
    font-size: clamp(1.5rem, 2.5vw, 2.1rem);
    color: var(--ink);
    line-height: 1.25;
  }

  .cta-subtitle {
    margin: 0;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.5;
  }

  .cta-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
    max-width: 58rem;
    margin: 0 auto;
  }

  .product-box {
    background: #ffffff;
    border: 1px solid rgba(45, 91, 227, 0.12);
    border-radius: var(--radius-md);
    padding: 1.85rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    box-shadow: 0 4px 12px rgba(14, 23, 38, 0.03);
  }

  .product-box:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(45, 91, 227, 0.08);
    border-color: var(--accent);
  }

  .product-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
    margin-bottom: 0.85rem;
  }

  .social-badge {
    background: #eef3ff;
    color: var(--accent);
  }

  .block-badge {
    background: #fbf6ec;
    color: #b38228;
  }

  .product-box h3 {
    margin: 0 0 0.6rem 0;
    font-size: 1.35rem;
    color: var(--ink);
  }

  .product-desc {
    margin: 0 0 1.5rem 0;
    color: var(--text-secondary);
    font-size: 0.94rem;
    line-height: 1.55;
  }

  .box-bottom {
    margin-top: auto;
  }

  .btn-full {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    text-align: center;
    box-sizing: border-box;
    padding: 0.85rem 1.25rem;
    font-size: 0.94rem;
  }

  .btn-primary {
    background: var(--accent);
    color: #ffffff;
    font-weight: 700;
    border-radius: var(--radius-full);
    text-decoration: none;
    border: none;
    box-shadow: 0 4px 12px rgba(45, 91, 227, 0.24);
    transition: background-color 0.2s, transform 0.2s;
  }

  .btn-primary:hover {
    background: var(--accent-deep);
    transform: translateY(-1px);
  }

  .btn-gold-outline {
    background: #ffffff;
    color: var(--ink);
    font-weight: 700;
    border-radius: var(--radius-full);
    text-decoration: none;
    border: 1px solid var(--border-color);
    transition: all 0.2s ease;
  }

  .btn-gold-outline:hover {
    background: #f7f9fd;
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-1px);
  }

  .play-icon {
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .cta-grid {
      grid-template-columns: 1fr;
    }

    .dual-cta-card {
      padding: 1.5rem;
    }
  }
</style>
