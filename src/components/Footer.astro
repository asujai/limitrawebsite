---
const currentYear = new Date().getFullYear();
const isEn = Astro.url.pathname.startsWith('/en');
const prefix = isEn ? '/en' : '';

const groups = [
  {
    title: isEn ? 'Product' : 'Ürün',
    links: [
      { href: `${prefix}/limitra`, label: isEn ? 'How it works' : 'Nasıl çalışır?' },
      { href: `${prefix}/sss`, label: isEn ? 'FAQ' : 'Sık sorulanlar' },
      { href: `${prefix}/iletisim`, label: isEn ? 'Contact' : 'İletişim' }
    ]
  },
  {
    title: isEn ? 'Explore' : 'Keşfet',
    links: [
      { href: `${prefix}/bilgi-merkezi`, label: isEn ? 'Knowledge center' : 'Bilgi merkezi' },
      { href: `${prefix}/bilgi-merkezi/ekran-suresi`, label: isEn ? 'Screen time guide' : 'Ekran süresi rehberi' },
      { href: `${prefix}/bilgi-merkezi/daha-net-uygulama-sinirlari`, label: isEn ? 'Clearer boundaries' : 'Daha net sınırlar' }
    ]
  },
  {
    title: isEn ? 'Legal' : 'Yasal',
    links: [
      { href: `${prefix}/gizlilik-politikasi`, label: isEn ? 'Privacy policy' : 'Gizlilik politikası' },
      { href: `${prefix}/kullanim-sartlari`, label: isEn ? 'Terms of use' : 'Kullanım şartları' }
    ]
  }
];
---

<footer class="footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <a href={isEn ? '/en' : '/'} class="brand">
        <span class="brand-mark" aria-hidden="true">L</span>
        <span>Limitra</span>
      </a>
      <p>{isEn ? 'Set your boundary when your mind is clear. Let Limitra protect it when distraction arrives.' : 'Sınırını zihnin sakinken belirle. Dikkatin dağıldığında onu Limitra korusun.'}</p>
      <a class="play-link" href="https://play.google.com/store/apps/details?id=com.gardiyan.app" target="_blank" rel="noopener noreferrer">
        {isEn ? 'Available on Google Play' : 'Google Play’de incele'} <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="footer-links">
      {groups.map((group) => (
        <div class="link-group">
          <h2>{group.title}</h2>
          <ul>
            {group.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {currentYear} Limitra. {isEn ? 'All rights reserved.' : 'Tüm hakları saklıdır.'}</p>
    <p>{isEn ? 'A supportive digital-discipline tool; not medical treatment.' : 'Dijital disiplini destekleyen bir araçtır; tıbbi tedavi değildir.'}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid rgba(255, 255, 255, .08);
    background: var(--surface-dark);
    color: white;
    padding: 4.5rem 0 2rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.2fr 1.8fr;
    gap: clamp(3rem, 8vw, 8rem);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: .72rem;
    margin-bottom: 1.25rem;
    color: white;
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
  }

  .brand:hover {
    color: white;
  }

  .brand-mark {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 1px solid rgba(255,255,255,.16);
    border-radius: .75rem;
    background: rgba(255,255,255,.08);
  }

  .footer-brand p {
    max-width: 25rem;
    margin-bottom: 1.4rem;
    color: #9eabc0;
    font-size: .92rem;
  }

  .play-link {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    color: white;
    font-size: .84rem;
    font-weight: 700;
  }

  .play-link:hover {
    color: var(--accent-light);
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .link-group h2 {
    margin: 0 0 1rem;
    color: white;
    font-family: var(--font-body);
    font-size: .77rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .link-group ul {
    display: flex;
    flex-direction: column;
    gap: .65rem;
    list-style: none;
  }

  .link-group a {
    color: #9eabc0;
    font-size: .86rem;
  }

  .link-group a:hover {
    color: white;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 4rem;
    border-top: 1px solid rgba(255,255,255,.09);
    padding-top: 1.5rem;
  }

  .footer-bottom p {
    margin: 0;
    color: #738198;
    font-size: .74rem;
  }

  @media (max-width: 800px) {
    .footer-top {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (max-width: 560px) {
    .footer-links {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
