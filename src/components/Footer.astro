---
import { translations, SUPPORTED_LANGUAGES, type SupportedLang } from '../data/translations';
import { routes } from '../data/routes';

interface Props {
  currentLang?: SupportedLang;
}

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const pathSegments = pathname.split('/').filter(Boolean);
const firstSegment = pathSegments[0] as SupportedLang;

const currentLang: SupportedLang = Astro.props.currentLang || (
  SUPPORTED_LANGUAGES.some(l => l.code === firstSegment) ? firstSegment : 'tr'
);

const t = translations[currentLang] || translations.en;
const currentYear = new Date().getFullYear();

// Tüm bağlantılar merkezi rota çözücüden gelir; bir bölüm o dilde yoksa
// İngilizce sürüme düşer, böylece 404 oluşmaz.
const r = routes(currentLang);
const homeHref = r.home;

const label = {
  contact: currentLang === 'tr' ? 'İletişim' : 'Contact',
  screenTimeGuide: currentLang === 'tr' ? 'Ekran süresi rehberi' : 'Screen time guide',
  privacy: currentLang === 'tr' ? 'Gizlilik politikası' : 'Privacy policy',
  terms: currentLang === 'tr' ? 'Kullanım şartları' : 'Terms of use',
  deleteAccount: currentLang === 'tr' ? 'Hesap ve veri silme' : 'Delete account & data'
};

const groups = [
  {
    title: t.footer.productTitle,
    links: [
      { href: r.howItWorks, label: t.nav.howItWorks },
      { href: r.faq, label: t.nav.faq },
      { href: r.contact, label: label.contact }
    ]
  },
  {
    title: t.footer.exploreTitle,
    links: [
      { href: r.news, label: t.nav.news },
      { href: r.guides, label: t.nav.guides },
      { href: r.guide('ekran-suresi'), label: label.screenTimeGuide }
    ]
  },
  {
    title: t.footer.legalTitle,
    links: [
      { href: r.privacy, label: label.privacy },
      { href: r.terms, label: label.terms }
    ]
  },
  {
    title: 'Limitra Social',
    links: [
      { href: '/limitra-social/privacy', label: label.privacy },
      { href: '/limitra-social/terms', label: label.terms },
      { href: '/limitra-social/delete-account', label: label.deleteAccount }
    ]
  }
];
---

<footer class="footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <a href={homeHref} class="brand">
        <img src="/logo.jpg" alt="Limitra App Block Logo" class="brand-logo" width="36" height="36" />
        <span class="brand-text">Limitra <span class="brand-badge">App Block</span></span>
      </a>
      <p>{t.hero.lead}</p>
      <a class="play-link" href="https://play.google.com/store/apps/details?id=com.gardiyan.app" target="_blank" rel="noopener noreferrer">
        {t.hero.ctaPrimary} <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="footer-links">
      {groups.map((group) => (
        <div class="link-group">
          <h2>{group.title}</h2>
          <ul>
            {group.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {currentYear} Limitra App Block. {t.footer.rights}</p>
    <p class="tagline">{t.footer.tagline}</p>
  </div>
</footer>

<style>
  .footer {
    background: #09162f;
    color: #e2e8f0;
    padding-top: 5rem;
    padding-bottom: 3rem;
    margin-top: 6rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.4fr 2fr;
    gap: 4rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .footer-brand .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    font-weight: 700;
    color: #ffffff;
    font-size: 1.25rem;
  }

  /* Koyu zeminli alt bilgi: marka metni beyaz olmali */
  .footer-brand .brand-text {
    color: #ffffff;
  }

  .footer-brand .brand-logo {
    border-radius: 8px;
  }

  .footer-brand .brand-badge {
    font-size: 0.72rem;
    font-weight: 600;
    background: rgba(99, 102, 241, 0.2);
    color: #a5b4fc;
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
    border: 1px solid rgba(99, 102, 241, 0.3);
  }

  .footer-brand p {
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
    font-size: 0.95rem;
    max-width: 360px;
  }

  .play-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    padding: 0.6rem 1.25rem;
    border-radius: 9999px;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition: all 0.2s ease;
  }

  .play-link:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
  }

  .link-group h2 {
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0 0 1.25rem 0;
    letter-spacing: 0.02em;
    font-family: inherit;
  }

  .link-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .link-group a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.88rem;
    transition: color 0.2s ease;
  }

  .link-group a:hover {
    color: #ffffff;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2.5rem;
    /* #64748b koyu zeminde 3.8:1 kaliyordu; WCAG AA icin acildi */
    color: #94a3b8;
    font-size: 0.85rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  .tagline {
    color: #94a3b8;
  }

  @media (max-width: 900px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .footer-links {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  @media (max-width: 540px) {
    .footer-links {
      grid-template-columns: 1fr;
    }
  }
</style>
