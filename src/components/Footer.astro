---
const currentYear = new Date().getFullYear();
const isEn = Astro.url.pathname.startsWith('/en');
const prefix = isEn ? '/en' : '';

const groups = [
  {
    title: isEn ? 'Product' : 'Ürün',
    links: [
      { href: `${prefix}/limitra`, label: isEn ? 'How it works' : 'Nasıl çalışır?' },
      { href: `${prefix}/sss`, label: isEn ? 'FAQ' : 'Sık sorulanlar' },
      { href: `${prefix}/iletisim`, label: isEn ? 'Contact' : 'İletişim' }
    ]
  },
  {
    title: isEn ? 'Press & Guides' : 'Basın & Rehberler',
    links: [
      { href: isEn ? '/en/news' : '/haberler', label: isEn ? 'Global Press News' : 'Dünya Basınından Haberler' },
      { href: `${prefix}/bilgi-merkezi`, label: isEn ? 'Knowledge center' : 'Bilgi merkezi' },
      { href: `${prefix}/bilgi-merkezi/ekran-suresi`, label: isEn ? 'Screen time guide' : 'Ekran süresi rehberi' },
      { href: `${prefix}/bilgi-merkezi/daha-net-uygulama-sinirlari`, label: isEn ? 'Clearer boundaries' : 'Daha net sınırlar' }
    ]
  },
  {
    title: isEn ? 'Limitra App Block' : 'Limitra Yasal',
    links: [
      { href: `${prefix}/gizlilik-politikasi`, label: isEn ? 'Privacy policy' : 'Gizlilik politikası' },
      { href: `${prefix}/kullanim-sartlari`, label: isEn ? 'Terms of use' : 'Kullanım şartları' }
    ]
  },
  {
    title: 'Limitra Social',
    links: [
      { href: '/limitra-social/privacy', label: isEn ? 'Privacy policy' : 'Gizlilik politikası' },
      { href: '/limitra-social/terms', label: isEn ? 'Terms of use' : 'Kullanım şartları' },
      { href: '/limitra-social/delete-account', label: isEn ? 'Delete account & data' : 'Hesap ve veri silme' }
    ]
  }
];
---

<footer class="footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <a href={isEn ? '/en' : '/'} class="brand">
        <img src="/logo.jpg" alt="Limitra App Block Logo" class="brand-logo" width="36" height="36" />
        <span class="brand-text">Limitra <span class="brand-badge">App Block</span></span>
      </a>
      <p>{isEn ? 'Set your boundary when your mind is clear. Let Limitra App Block protect it when distraction arrives.' : 'Sınırını zihnin sakinken belirle. Dikkatin dağıldığında onu Limitra App Block korusun.'}</p>
      <a class="play-link" href="https://play.google.com/store/apps/details?id=com.gardiyan.app" target="_blank" rel="noopener noreferrer">
        {isEn ? 'Available on Google Play' : 'Google Play’de incele'} <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="footer-links">
      {groups.map((group) => (
        <div class="link-group">
          <h2>{group.title}</h2>
          <ul>
            {group.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="container footer-bottom">
    <p>© {currentYear} Limitra App Block. {isEn ? 'All rights reserved.' : 'Tüm hakları saklıdır.'}</p>
    <p>{isEn ? 'A supportive digital-discipline & app blocking tool.' : 'Dijital disiplini destekleyen bir uygulama engelleyicidir.'}</p>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid rgba(255, 255, 255, .08);
    background: var(--surface-dark);
    color: white;
    padding: 4.5rem 0 2rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(2rem, 5vw, 5rem);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: .72rem;
    margin-bottom: 1.25rem;
    padding: .4rem .85rem .4rem .45rem;
    background: #ffffff;
    border-radius: .85rem;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.18);
    color: #000000;
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 800;
    text-decoration: none;
    transition: transform .2s ease, box-shadow .2s ease;
  }

  .brand:hover {
    color: #000000;
    background: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.25);
  }

  .brand-logo {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: .6rem;
    object-fit: cover;
  }

  .brand-text {
    color: #000000 !important;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .brand-badge {
    display: inline-block;
    font-size: 0.62rem;
    font-weight: 800;
    color: var(--accent);
    background: var(--accent-soft);
    border: 1px solid var(--accent-border);
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-full);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    vertical-align: middle;
  }

  .footer-brand p {
    max-width: 25rem;
    margin-bottom: 1.4rem;
    color: #9eabc0;
    font-size: .92rem;
  }

  .play-link {
    display: inline-flex;
    align-items: center;
    gap: .5rem;
    color: white;
    font-size: .84rem;
    font-weight: 700;
  }

  .play-link:hover {
    color: var(--accent-light);
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .link-group h2 {
    margin: 0 0 1rem;
    color: white;
    font-family: var(--font-body);
    font-size: .77rem;
    font-weight: 700;
    letter-spacing: .1em;
    text-transform: uppercase;
  }

  .link-group ul {
    display: flex;
    flex-direction: column;
    gap: .65rem;
    list-style: none;
  }

  .link-group a {
    color: #9eabc0;
    font-size: .86rem;
  }

  .link-group a:hover {
    color: white;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 4rem;
    border-top: 1px solid rgba(255,255,255,.09);
    padding-top: 1.5rem;
  }

  .footer-bottom p {
    margin: 0;
    color: #738198;
    font-size: .74rem;
  }

  @media (max-width: 960px) {
    .footer-top {
      grid-template-columns: 1fr;
    }

    .footer-links {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  @media (max-width: 600px) {
    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-links {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
