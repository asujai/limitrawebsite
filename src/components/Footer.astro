---
import { translations, SUPPORTED_LANGUAGES, type SupportedLang } from '../data/translations';
import { routes } from '../data/routes';
import { homeCopy, SOCIAL_STORE_URL, BLOCK_STORE_URL } from '../data/home';

interface Props {
  currentLang?: SupportedLang;
}

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const pathSegments = pathname.split('/').filter(Boolean);
const firstSegment = pathSegments[0] as SupportedLang;

const currentLang: SupportedLang = Astro.props.currentLang || (
  SUPPORTED_LANGUAGES.some(l => l.code === firstSegment) ? firstSegment : 'tr'
);

const t = translations[currentLang] || translations.en;
const currentYear = new Date().getFullYear();

// Tüm bağlantılar merkezi rota çözücüden gelir; bir bölüm o dilde yoksa
// İngilizce sürüme düşer, böylece 404 oluşmaz.
const r = routes(currentLang);
const homeHref = r.home;

const tr = currentLang === 'tr';
const label = {
  contact: tr ? 'İletişim' : 'Contact',
  screenTimeGuide: tr ? 'Ekran süresi rehberi' : 'Screen time guide',
  privacy: tr ? 'Gizlilik politikası' : 'Privacy policy',
  terms: tr ? 'Kullanım şartları' : 'Terms of use',
  deleteAccount: tr ? 'Hesap ve veri silme' : 'Delete account & data',
  onPlay: tr ? 'Google Play’de' : 'On Google Play',
  compare: tr ? 'Karşılaştırma' : 'Compare',
  changelog: tr ? 'Değişiklik günlüğü' : 'Changelog',
  whatIs: tr ? 'Limitra App Block nedir?' : 'What is Limitra App Block?',
  howItWorksDeep: tr ? 'Nasıl çalışır?' : 'How it works',
  agentDiscovery: tr ? 'AI & Ajan Portalı' : 'AI & Agent Portal'
};

const groups = [
  {
    title: 'Limitra Social',
    links: [
      { href: SOCIAL_STORE_URL, label: label.onPlay, external: true },
      { href: '/limitra-social/privacy', label: label.privacy },
      { href: '/limitra-social/terms', label: label.terms },
      { href: '/limitra-social/delete-account', label: label.deleteAccount }
    ]
  },
  {
    title: 'Limitra App Block',
    links: [
      { href: BLOCK_STORE_URL, label: label.onPlay, external: true },
      { href: r.whatIs, label: label.whatIs },
      { href: r.howItWorksDeep, label: label.howItWorksDeep },
      { href: r.compare, label: label.compare },
      { href: r.changelog, label: label.changelog },
      { href: r.privacy, label: label.privacy },
      { href: r.terms, label: label.terms }
    ]
  },
  {
    title: t.footer.exploreTitle,
    links: [
      { href: r.news, label: t.nav.news },
      { href: r.guides, label: t.nav.guides },
      { href: r.guide('ekran-suresi'), label: label.screenTimeGuide },
      { href: r.faq, label: t.nav.faq },
      { href: r.agentDiscovery, label: label.agentDiscovery },
      { href: r.contact, label: label.contact }
    ]
  }
];
---

<footer class="footer">
  <div class="container footer-top">
    <div class="footer-brand">
      <a href={homeHref} class="brand">
        <img src="/logo.png" alt="" class="brand-logo" width="34" height="34" />
        <span class="brand-text">Limitra</span>
      </a>
      <p>{(homeCopy[currentLang] ?? homeCopy.en).tagline}</p>
      <a class="play-link" href={SOCIAL_STORE_URL} target="_blank" rel="noopener noreferrer">
        {(homeCopy[currentLang] ?? homeCopy.en).hero.cta} <span aria-hidden="true">↗</span>
      </a>
    </div>

    <div class="footer-links">
      {groups.map((group) => (
        <div class="link-group">
          <h2>{group.title}</h2>
          <ul>
            {group.links.map((link) => (
              <li>
                {'external' in link && link.external
                  ? <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label} <span aria-hidden="true">↗</span></a>
                  : <a href={link.href}>{link.label}</a>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {currentYear} Limitra. {t.footer.rights}</p>
    <p class="tagline">{t.footer.tagline}</p>
  </div>
</footer>

<style>
  .footer {
    background: var(--ink, #0e1726);
    color: #e2e8f0;
    padding-top: 5rem;
    padding-bottom: 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .footer-brand .brand-text {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.4fr 2fr;
    gap: 4rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .footer-brand .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    font-weight: 700;
    color: #ffffff;
    font-size: 1.25rem;
  }

  /* Koyu zeminli alt bilgi: marka metni beyaz olmali */
  .footer-brand .brand-text {
    color: #ffffff;
  }

  .footer-brand .brand-logo {
    border-radius: 8px;
  }

  .footer-brand .brand-badge {
    font-size: 0.72rem;
    font-weight: 600;
    background: rgba(99, 102, 241, 0.2);
    color: #a5b4fc;
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
    border: 1px solid rgba(99, 102, 241, 0.3);
  }

  .footer-brand p {
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
    font-size: 0.95rem;
    max-width: 360px;
  }

  .play-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: rgba(255, 255, 255, 0.1);
    color: #ffffff;
    padding: 0.6rem 1.25rem;
    border-radius: 9999px;
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.15);
    transition: all 0.2s ease;
  }

  .play-link:hover {
    background: rgba(255, 255, 255, 0.18);
    border-color: rgba(255, 255, 255, 0.3);
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .link-group h2 {
    color: #ffffff;
    font-size: 0.95rem;
    font-weight: 600;
    margin: 0 0 1.25rem 0;
    letter-spacing: 0.02em;
    font-family: inherit;
  }

  .link-group ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .link-group a {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.88rem;
    transition: color 0.2s ease;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.25rem 0;
  }

  .link-group a:hover {
    color: #ffffff;
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 2.5rem;
    /* #64748b koyu zeminde 3.8:1 kaliyordu; WCAG AA icin acildi */
    color: #94a3b8;
    font-size: 0.85rem;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .footer-bottom p {
    margin: 0;
  }

  .tagline {
    color: #94a3b8;
  }

  @media (max-width: 900px) {
    .footer-top {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .footer-links {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
    }
  }

  @media (max-width: 540px) {
    .footer-links {
      grid-template-columns: 1fr;
    }
  }
</style>
