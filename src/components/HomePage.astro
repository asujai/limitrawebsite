---
import Layout from '../layouts/Layout.astro';
import haberlerTr from '../data/haberler.json';
import haberlerEn from '../data/news-en.json';

interface Props {
  lang?: 'tr' | 'en';
}

const { lang = 'tr' } = Astro.props;
const isEn = lang === 'en';
const prefix = isEn ? '/en' : '';
const playUrl = 'https://play.google.com/store/apps/details?id=com.gardiyan.app';

const latestNews = (isEn ? haberlerEn : haberlerTr).slice(0, 3);

const steps = isEn ? [
  { num: '01', title: 'Choose the distractions', text: 'Select the apps that steal your attention most often.' },
  { num: '02', title: 'Set a clear limit', text: 'Decide how much time each app deserves while your mind is clear.' },
  { num: '03', title: 'Let Limitra App Block protect it', text: 'When time is up, the boundary you set becomes a real pause.' }
] : [
  { num: '01', title: 'Dikkat dağıtanları seç', text: 'Seni en sık ekrana çeken uygulamaları belirle.' },
  { num: '02', title: 'Net bir sınır koy', text: 'Zihnin sakinken her uygulamanın hak ettiği süreye karar ver.' },
  { num: '03', title: 'Korumayı Limitra App Block’a bırak', text: 'Süre dolduğunda verdiğin karar gerçek bir molaya dönüşsün.' }
];

const guides = isEn ? [
  { href: '/en/bilgi-merkezi/ekran-suresi', meta: '6 min', title: 'Understand your screen time', text: 'See what constant phone use does to focus and daily rhythm.' },
  { href: '/en/bilgi-merkezi/klasik-limitler-neden-yetmez', meta: '5 min', title: 'Why soft limits are easy to ignore', text: 'Explore why a warning is often not enough at the moment of temptation.' },
  { href: '/en/bilgi-merkezi/dikkat-uyku-ve-rutinler', meta: '7 min', title: 'Protect sleep and attention', text: 'Build calmer evening routines without relying on willpower alone.' }
] : [
  { href: '/bilgi-merkezi/ekran-suresi', meta: '6 dk', title: 'Ekran süreni gerçekten anla', text: 'Sürekli telefon kullanımının dikkat ve günlük ritim üzerindeki etkisini gör.' },
  { href: '/bilgi-merkezi/klasik-limitler-neden-yetmez', meta: '5 dk', title: 'Yumuşak limitler neden yetmez?', text: 'Bir uyarının dürtü anında neden kolayca yok sayıldığını keşfet.' },
  { href: '/bilgi-merkezi/dikkat-uyku-ve-rutinler', meta: '7 dk', title: 'Uyku ve dikkatini koru', text: 'Yalnızca iradeye güvenmeden daha sakin akşam rutinleri kur.' }
];
---

<Layout
  title={isEn ? 'Limitra App Block | Screen Time Control & App Blocker' : 'Limitra App Block | Ekran Süresini Kontrol Et, Uygulama Engelleyici ve Dijital Denge'}
  description={isEn ? 'Control screen time, block distracting apps, and build digital discipline with Limitra App Block.' : 'Limitra App Block ile ekran süreni kontrol et, uygulama kullanımını sınırla ve dijital alışkanlıklarını daha bilinçli şekilde yönet.'}
  ogTitle={isEn ? 'Limitra App Block | Screen Time Control' : 'Limitra App Block | Ekran Süresini Kontrol Et'}
  ogDescription={isEn ? 'Manage your screen time and digital habits more mindfully with Limitra App Block.' : 'Ekran süreni ve dijital alışkanlıklarını Limitra App Block ile daha bilinçli yönet.'}
>
  <section class="hero">
    <div class="hero-glow glow-one"></div>
    <div class="hero-glow glow-two"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow"><span class="signal-dot"></span>{isEn ? 'A calmer digital rhythm' : 'Daha sakin bir dijital ritim'}</span>
        <h1>{isEn ? <>Decide now.<br /><em>Limitra App Block protects it later.</em></> : <>Kararını şimdi ver.<br /><em>Limitra App Block sonra korusun.</em></>}</h1>
        <p class="hero-lead">
          {isEn ? 'Set clear limits while your mind is calm. When distraction arrives, Limitra App Block helps you stay loyal to the decision you already made.' : 'Sınırını zihnin sakinken belirle. Dikkatin dağıldığında Limitra App Block, daha önce verdiğin karara sadık kalmana yardımcı olsun.'}
        </p>
        <div class="hero-actions">
          <a href={playUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            <span>{isEn ? 'Get it on Google Play' : 'Google Play’den indir'}</span><span aria-hidden="true">↗</span>
          </a>
          <a href={`${prefix}/limitra`} class="text-link">{isEn ? 'See how it works' : 'Nasıl çalıştığını gör'} <span aria-hidden="true">→</span></a>
        </div>
        <div class="hero-trust" aria-label={isEn ? 'Product qualities' : 'Ürün özellikleri'}>
          <span><i></i>{isEn ? 'On-device data' : 'Veriler cihazda'}</span>
          <span><i></i>{isEn ? 'No ads' : 'Reklamsız'}</span>
          <span><i></i>{isEn ? 'Built for Android' : 'Android için'}</span>
        </div>
      </div>

      <div class="product-visual" aria-label={isEn ? 'Representative Limitra product interface' : 'Temsili Limitra ürün arayüzü'}>
        <div class="orbit orbit-one"></div>
        <div class="orbit orbit-two"></div>
        <div class="phone-shell">
          <div class="phone-top"><span>9:41</span><span class="phone-sensors">● ◔ ▰</span></div>
          <div class="app-head">
            <div>
              <span class="app-kicker"><img src="/logo.jpg" alt="" class="kicker-logo" /> LIMITRA</span>
              <strong>{isEn ? 'Good morning' : 'Günaydın'}</strong>
            </div>
            <span class="profile-dot">A</span>
          </div>
          <div class="focus-card">
            <div class="focus-top">
              <span>{isEn ? 'Today’s focus' : 'Bugünün odağı'}</span>
              <strong>62%</strong>
            </div>
            <div class="progress-track"><span></span></div>
            <div class="focus-bottom"><span>{isEn ? '38 min protected' : '38 dk korundu'}</span><span>{isEn ? 'Goal: 60 min' : 'Hedef: 60 dk'}</span></div>
          </div>
          <div class="app-section-title"><strong>{isEn ? 'Active limits' : 'Aktif sınırlar'}</strong><span>{isEn ? 'Edit' : 'Düzenle'}</span></div>
          <div class="limit-row">
            <span class="app-icon blue">S</span>
            <div><strong>{isEn ? 'Social media' : 'Sosyal medya'}</strong><small>{isEn ? '18 of 30 min used' : '30 dk’nın 18 dk’sı'}</small></div>
            <span class="time-pill">12 dk</span>
          </div>
          <div class="limit-row">
            <span class="app-icon coral">V</span>
            <div><strong>{isEn ? 'Short videos' : 'Kısa videolar'}</strong><small>{isEn ? '14 of 20 min used' : '20 dk’nın 14 dk’sı'}</small></div>
            <span class="time-pill">6 dk</span>
          </div>
          <div class="streak-card">
            <span class="streak-icon">7</span>
            <div><strong>{isEn ? '7-day streak' : '7 günlük seri'}</strong><small>{isEn ? 'Your boundary stayed intact.' : 'Sınırın bugün de korundu.'}</small></div>
          </div>
          <div class="app-nav"><span class="active">●</span><span>■</span><span>◆</span></div>
        </div>
        <div class="float-card float-left"><span class="float-icon">✓</span><div><strong>{isEn ? 'Boundary active' : 'Sınır aktif'}</strong><small>{isEn ? 'Protected until tomorrow' : 'Yarına kadar korunuyor'}</small></div></div>
        <div class="float-card float-right"><span class="float-number">38</span><div><strong>{isEn ? 'minutes' : 'dakika'}</strong><small>{isEn ? 'saved today' : 'bugün geri kazanıldı'}</small></div></div>
        <p class="visual-note">{isEn ? 'Representative product interface' : 'Temsili ürün arayüzü'}</p>
      </div>
    </div>
  </section>

  <section class="principles" aria-label={isEn ? 'Limitra App Block principles' : 'Limitra App Block ilkeleri'}>
    <div class="container principle-grid">
      <div><span>01</span><p><strong>{isEn ? 'Clear' : 'Net'}</strong>{isEn ? 'A boundary you can understand at a glance.' : 'Bir bakışta anlayabileceğin sınırlar.'}</p></div>
      <div><span>02</span><p><strong>{isEn ? 'Private' : 'Gizli'}</strong>{isEn ? 'Sensitive usage data stays on your device.' : 'Hassas kullanım verileri cihazında kalır.'}</p></div>
      <div><span>03</span><p><strong>{isEn ? 'Calm' : 'Sakin'}</strong>{isEn ? 'No noisy dashboards, ads or guilt.' : 'Gürültülü ekranlar, reklamlar ve suçluluk yok.'}</p></div>
    </div>
  </section>

  <section class="moment-section">
    <div class="container moment-grid">
      <div class="moment-copy">
        <span class="eyebrow light"><span class="signal-dot"></span>{isEn ? 'The real problem' : 'Asıl problem'}</span>
        <h2>{isEn ? 'You already know when to stop. The hard part is stopping in that moment.' : 'Ne zaman durman gerektiğini zaten biliyorsun. Zor olan, o anda durabilmek.'}</h2>
        <p>{isEn ? 'Most screen-time tools arrive as one more notification you can dismiss. Limitra App Block turns the decision you made earlier into a clear pause when it matters.' : 'Çoğu ekran süresi aracı, kapatabileceğin bir bildirim daha gönderir. Limitra App Block ise daha önce verdiğin kararı, ihtiyaç duyduğun anda net bir molaya dönüştürür.'}</p>
      </div>
      <div class="moment-card">
        <span class="moment-label">{isEn ? 'A familiar loop' : 'Tanıdık bir döngü'}</span>
        <div class="moment-row"><strong>22:14</strong><span>{isEn ? '“I’ll look for five minutes.”' : '“Beş dakika bakıp çıkarım.”'}</span></div>
        <div class="moment-line"><i></i></div>
        <div class="moment-row"><strong>22:47</strong><span>{isEn ? 'Still scrolling.' : 'Hâlâ kaydırıyorsun.'}</span></div>
        <div class="moment-pause"><img src="/logo.jpg" alt="Limitra App Block Logo" class="moment-logo" /><span class="moment-brand">Limitra App Block</span><strong>{isEn ? 'The boundary you set is now active.' : 'Belirlediğin sınır şimdi aktif.'}</strong></div>
      </div>
    </div>
  </section>

  <section class="steps-section" id="how-it-works">
    <div class="container">
      <div class="section-heading">
        <div><span class="eyebrow"><span class="signal-dot"></span>{isEn ? 'Three simple steps' : 'Üç sade adım'}</span><h2>{isEn ? 'Less negotiating. More living.' : 'Daha az pazarlık. Daha çok hayat.'}</h2></div>
        <p>{isEn ? 'Limitra App Block keeps setup short so the tool itself never becomes another distraction.' : 'Limitra App Block kurulumu kısa tutar; böylece aracın kendisi yeni bir dikkat dağıtıcıya dönüşmez.'}</p>
      </div>
      <div class="steps-grid">
        {steps.map((step) => (
          <article class="step-card">
            <span>{step.num}</span>
            <div class="step-glyph" aria-hidden="true"><i></i><i></i><i></i></div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="feature-section">
    <div class="container feature-grid">
      <div class="feature-copy">
        <span class="eyebrow"><span class="signal-dot"></span>{isEn ? 'Progress without pressure' : 'Baskı kurmadan ilerleme'}</span>
        <h2>{isEn ? 'See the pattern. Strengthen the habit.' : 'Deseni gör. Alışkanlığı güçlendir.'}</h2>
        <p>{isEn ? 'A simple timeline and discipline summary help you understand what happened without turning your life into a spreadsheet.' : 'Sade zaman tüneli ve disiplin özeti, hayatını bir tabloya çevirmeden ne olduğunu anlamanı sağlar.'}</p>
        <ul class="check-list">
          <li><span>✓</span>{isEn ? 'See when limits became active' : 'Limitlerin ne zaman devreye girdiğini gör'}</li>
          <li><span>✓</span>{isEn ? 'Review your recent consistency' : 'Yakın dönem istikrarını incele'}</li>
          <li><span>✓</span>{isEn ? 'Keep the story local to your device' : 'Tüm geçmişi cihazında tut'}</li>
        </ul>
        <a href={`${prefix}/limitra`} class="text-link">{isEn ? 'Explore every feature' : 'Tüm özellikleri incele'} <span aria-hidden="true">→</span></a>
      </div>

      <div class="insight-panel">
        <div class="panel-tabs"><span class="active">{isEn ? 'Discipline' : 'Disiplin'}</span><span>{isEn ? 'Timeline' : 'Zaman tüneli'}</span></div>
        <div class="streak-summary">
          <div><span>{isEn ? 'CURRENT STREAK' : 'AKTİF SERİ'}</span><strong>7 <small>{isEn ? 'days' : 'gün'}</small></strong></div>
          <span class="status-ring">7</span>
        </div>
        <div class="day-grid" aria-hidden="true">
          {Array.from({ length: 21 }, (_, index) => <span class:list={{ today: index === 20, missed: index === 8 || index === 15 }}>{index + 1}</span>)}
        </div>
        <div class="panel-legend"><span><i class="done"></i>{isEn ? 'Boundary kept' : 'Sınır korundu'}</span><span><i class="miss"></i>{isEn ? 'Missed' : 'Kaçırıldı'}</span><span><i class="current"></i>{isEn ? 'Today' : 'Bugün'}</span></div>
      </div>
    </div>
  </section>

  <section class="privacy-section">
    <div class="container privacy-card">
      <div class="privacy-mark" aria-hidden="true"><span></span></div>
      <div class="privacy-copy">
        <span class="eyebrow light"><span class="signal-dot"></span>{isEn ? 'Privacy by design' : 'Tasarım gereği gizli'}</span>
        <h2>{isEn ? 'Your digital habits are yours.' : 'Dijital alışkanlıkların sana ait.'}</h2>
        <p>{isEn ? 'Usage information is processed on your Android device. Limitra App Block is designed to protect your attention—not to turn it into another data source.' : 'Kullanım bilgilerin Android cihazında işlenir. Limitra App Block, dikkatini korumak için tasarlandı; onu yeni bir veri kaynağına çevirmek için değil.'}</p>
      </div>
      <div class="privacy-points">
        <div><strong>{isEn ? 'On your device' : 'Cihazında'}</strong><span>{isEn ? 'Local processing' : 'Yerel veri işleme'}</span></div>
        <div><strong>{isEn ? 'No ads' : 'Reklamsız'}</strong><span>{isEn ? 'No attention traps' : 'Dikkat tuzağı yok'}</span></div>
        <div><strong>{isEn ? 'Minimal' : 'Minimal'}</strong><span>{isEn ? 'Only what you need' : 'Yalnızca ihtiyacın olan'}</span></div>
      </div>
    </div>
  </section>

  <!-- Dünya Basınından Gelişmeler Bölümü -->
  <section class="home-news-section">
    <div class="container">
      <div class="section-heading news-home-heading">
        <div>
          <span class="eyebrow"><span class="signal-dot"></span>{isEn ? 'Global Press & Laws' : 'Dünya Basını ve Yasalar'}</span>
          <h2>{isEn ? 'Governments are taking action. What about you?' : 'Dünya harekete geçiyor. Ya siz?'}</h2>
        </div>
        <a href={isEn ? '/en/news' : '/haberler'} class="text-link">
          {isEn ? 'All global news' : 'Tüm dünya haberleri'} <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="home-news-grid">
        {latestNews.map((item) => (
          <article class="home-news-card">
            <div class="home-news-meta">
              <span class="home-news-cat">{item.category}</span>
              <span class="home-news-date">{item.date}</span>
            </div>
            <h3>
              <a href={isEn ? `/en/news/${item.slug}` : `/haberler/${item.slug}`}>{item.title}</a>
            </h3>
            <p>{item.summary}</p>
            <div class="home-news-footer">
              <span class="home-news-source">{item.source}</span>
              <a href={isEn ? `/en/news/${item.slug}` : `/haberler/${item.slug}`} class="home-news-link">
                {isEn ? 'Read' : 'Oku'} &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="guides-section">
    <div class="container">
      <div class="section-heading guides-heading">
        <div><span class="eyebrow"><span class="signal-dot"></span>{isEn ? 'Read, understand, change' : 'Oku, anla, değiştir'}</span><h2>{isEn ? 'Knowledge for a calmer relationship with technology.' : 'Teknolojiyle daha sakin bir ilişki için bilgi.'}</h2></div>
        <a href={`${prefix}/bilgi-merkezi`} class="text-link">{isEn ? 'All guides' : 'Tüm rehberler'} <span aria-hidden="true">→</span></a>
      </div>
      <div class="guides-grid">
        {guides.map((guide, index) => (
          <a href={guide.href} class="guide-card">
            <div class={`guide-visual visual-${index + 1}`}><span>{String(index + 1).padStart(2, '0')}</span><i></i></div>
            <span class="guide-meta">{guide.meta}</span>
            <h3>{guide.title}</h3>
            <p>{guide.text}</p>
            <span class="guide-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="container cta-card">
      <div class="cta-orb orb-a"></div><div class="cta-orb orb-b"></div>
      <span class="eyebrow light"><span class="signal-dot"></span>{isEn ? 'Start today' : 'Bugün başla'}</span>
      <h2>{isEn ? 'Make room for what matters.' : 'Önemli olana yer aç.'}</h2>
      <p>{isEn ? 'Set one clear boundary today and give your attention somewhere better.' : 'Bugün tek bir net sınır koy ve dikkatini daha iyi bir yere ver.'}</p>
      <a href={playUrl} target="_blank" rel="noopener noreferrer" class="btn cta-button">{isEn ? 'Get Limitra App Block on Google Play' : 'Limitra App Block’u Google Play’den indir'} <span aria-hidden="true">↗</span></a>
      <small>{isEn ? 'For Android 8.0 and newer' : 'Android 8.0 ve üzeri'}</small>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(4.5rem, 9vw, 8rem) 0 5rem;
    background: radial-gradient(circle at 78% 28%, rgba(93, 140, 255, .14), transparent 31%), linear-gradient(180deg, #f9faff 0%, #f5f7fc 100%);
  }

  .hero-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    pointer-events: none;
  }

  .glow-one { width: 24rem; height: 24rem; top: -12rem; left: -12rem; background: rgba(38, 103, 245, .07); }
  .glow-two { width: 18rem; height: 18rem; right: -8rem; bottom: -8rem; border: 1px solid rgba(38, 103, 245, .16); }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(420px, .92fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 7rem);
  }

  .hero-grid > * {
    min-width: 0;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    margin-bottom: 1.25rem;
    color: var(--accent);
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .eyebrow.light { color: #9fbbff; }
  .signal-dot { width: .45rem; height: .45rem; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 .25rem color-mix(in srgb, currentColor 14%, transparent); }

  .hero-copy h1 { max-width: 12ch; margin-bottom: 1.5rem; }
  .hero-copy h1 em { color: var(--accent); font-style: normal; }
  .hero-lead { max-width: 38rem; margin-bottom: 2rem; font-size: clamp(1.05rem, 2vw, 1.2rem); line-height: 1.72; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.25rem; }

  .text-link { display: inline-flex; align-items: center; gap: .45rem; color: var(--text-primary); font-size: .9rem; font-weight: 700; }
  .text-link:hover { gap: .7rem; color: var(--accent); }

  .hero-trust { display: flex; flex-wrap: wrap; gap: .75rem 1.15rem; margin-top: 2rem; }
  .hero-trust span { display: inline-flex; align-items: center; gap: .45rem; color: var(--text-muted); font-size: .75rem; font-weight: 600; }
  .hero-trust i { width: .36rem; height: .36rem; border-radius: 50%; background: var(--green); }

  .product-visual { position: relative; min-height: 630px; display: grid; place-items: center; }
  .orbit { position: absolute; border: 1px solid rgba(38,103,245,.13); border-radius: 50%; }
  .orbit-one { width: 32rem; height: 32rem; }
  .orbit-two { width: 25rem; height: 25rem; border-style: dashed; }

  .phone-shell {
    position: relative;
    z-index: 2;
    width: 305px;
    min-height: 590px;
    overflow: hidden;
    border: 7px solid #0b1730;
    border-radius: 2.8rem;
    background: #f8f9fd;
    padding: .85rem 1rem 0;
    box-shadow: 0 38px 90px rgba(15, 37, 89, .22), inset 0 0 0 1px rgba(255,255,255,.5);
    transform: rotate(2.2deg);
  }

  .phone-top { display: flex; justify-content: space-between; padding: 0 .25rem .9rem; color: #0b1730; font-size: .62rem; font-weight: 800; }
  .phone-sensors { letter-spacing: .06em; }
  .app-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
  .app-head div { display: flex; flex-direction: column; }
  .app-head strong { color: var(--text-primary); font-family: var(--font-heading); font-size: 1.25rem; }
  .app-kicker { color: var(--accent); font-size: .55rem; font-weight: 800; letter-spacing: .16em; }
  .profile-dot { display: grid; width: 2rem; height: 2rem; place-items: center; border-radius: .7rem; background: var(--accent-soft); color: var(--accent); font-size: .72rem; font-weight: 800; }

  .focus-card { border-radius: 1.15rem; background: var(--surface-dark); padding: 1rem; box-shadow: 0 16px 28px rgba(9,22,47,.14); }
  .focus-top, .focus-bottom { display: flex; justify-content: space-between; align-items: center; color: white; }
  .focus-top span { font-size: .68rem; font-weight: 600; }
  .focus-top strong { font-family: var(--font-heading); font-size: 1.05rem; }
  .progress-track { height: .4rem; margin: .8rem 0 .55rem; overflow: hidden; border-radius: 1rem; background: rgba(255,255,255,.15); }
  .progress-track span { display: block; width: 62%; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #5c8cff, #8dafff); }
  .focus-bottom { color: #9eabc0; font-size: .52rem; }

  .app-section-title { display: flex; justify-content: space-between; margin: 1.15rem 0 .65rem; font-size: .66rem; }
  .app-section-title span { color: var(--accent); font-weight: 700; }
  .limit-row { display: grid; grid-template-columns: 2rem 1fr auto; align-items: center; gap: .65rem; margin-bottom: .58rem; border: 1px solid var(--border-soft); border-radius: .9rem; background: white; padding: .68rem; box-shadow: 0 6px 16px rgba(22,43,78,.04); }
  .limit-row > div { display: flex; min-width: 0; flex-direction: column; }
  .limit-row strong { overflow: hidden; color: var(--text-primary); font-size: .62rem; text-overflow: ellipsis; white-space: nowrap; }
  .limit-row small { color: var(--text-muted); font-size: .48rem; }
