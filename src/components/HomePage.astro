---
import Layout from '../layouts/Layout.astro';
import { translations, type SupportedLang } from '../data/translations';
import { routes, newsByLang } from '../data/routes';
import { homeCopy, blockProof, SOCIAL_STORE_URL, BLOCK_STORE_URL } from '../data/home';

interface Props {
  lang?: SupportedLang;
}

const { lang = 'tr' } = Astro.props;
const t = translations[lang] || translations.en;
const c = homeCopy[lang] || homeCopy.en;
const r = routes(lang);
const isRtl = lang === 'ar';

const news = (newsByLang[lang] || newsByLang.en).slice(0, 3);
const [leadNews, ...sideNews] = news;

const guides = lang === 'tr' ? [
  { href: r.guide('ekran-suresi'), meta: '6 dk', title: 'Ekran süreni gerçekten anla' },
  { href: r.guide('klasik-limitler-neden-yetmez'), meta: '5 dk', title: 'Yumuşak limitler neden yetmez?' },
  { href: r.guide('dikkat-uyku-ve-rutinler'), meta: '7 dk', title: 'Uyku ve dikkatini koru' }
] : lang === 'en' ? [
  { href: r.guide('ekran-suresi'), meta: '6 min', title: 'Understand your screen time' },
  { href: r.guide('klasik-limitler-neden-yetmez'), meta: '5 min', title: 'Why soft limits are easy to ignore' },
  { href: r.guide('dikkat-uyku-ve-rutinler'), meta: '7 min', title: 'Protect sleep and attention' }
] : [];

const [n1, n2, n3] = c.social.names;
const toast = c.phone.toast.replace('{name}', n1);
const heroQuote = c.quotes.items[0];
const nightQuote = c.quotes.items[2];

const friends = [
  { name: n1, frame: 'gold', app: 'Instagram', used: 18, limit: 30, status: 'on', best: 112 },
  { name: n2, frame: 'teal', app: 'TikTok', used: 52, limit: 60, status: 'near', best: 45 },
  { name: n3, frame: 'none', app: 'YouTube', used: 74, limit: 60, status: 'over', best: 9 }
] as const;
const statusLabel = { on: c.social.on, near: c.social.near, over: c.social.over };

const handles = ['atlas', 'mavi.kare', 'kuzey.foto', 'rota', 'studio.k', 'ada', 'pixel.gun', 'lumen', 'sahil', 'nokta', 'ufuk', 'orbit', 'kare.kare', 'yol'];
const feedPosts = handles.map((handle, i) => ({ handle, art: (i % 6) + 1, likes: 120 + ((i * 37) % 900) }));
const miniPosts = feedPosts.slice(0, 6);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: c.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a }
  }))
};
---

<Layout title={c.meta.title} description={c.meta.desc} lang={lang} jsonLd={faqSchema}>
  <!-- GİRİŞ: Limitra Social önde -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <h1>
          <span class="h1-line">{c.hero.h1a}</span>
          <em class="h1-line h1-accent">{c.hero.h1b}</em>
        </h1>
        <p class="hero-lead">{c.hero.lead}</p>
        <div class="hero-actions">
          <a href={SOCIAL_STORE_URL} target="_blank" rel="noopener noreferrer" class="play">
            <svg class="play-glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3.8v16.4c0 .8.9 1.3 1.6.9l13-8.2c.6-.4.6-1.4 0-1.8l-13-8.2C6.9 2.5 6 3 6 3.8Z" /></svg>
            <span>{c.hero.cta}</span>
          </a>
          <span class="hero-note">{c.hero.note}</span>
        </div>
        <a href="#app-block" class="hero-alt">
          <span>{c.hero.alt}</span>
          <strong>{c.hero.altLink} <span class="arrow" aria-hidden="true">→</span></strong>
        </a>
      </div>

      <div class="stage" data-hero aria-hidden="true">
        <div class="stage-disc"></div>
        <div class="phone">
          <div class="screen">
            <div class="statusbar"><span>9:41</span><span class="status-dots"><i></i><i></i><i></i></span></div>
            <div class="usage">
              <div class="usage-app">
                <span class="tile tile-ig">I</span>
                <div><strong>Instagram</strong><small>{c.phone.limit}</small></div>
              </div>
              <p class="usage-label">{c.phone.today}</p>
              <p class="usage-time"><span data-hero-time>26:40</span><small>/ 30:00</small></p>
              <div class="meter"><span data-hero-meter></span></div>
            </div>
            <div class="mini-feed">
              <div class="mini-track">
                {[...miniPosts, ...miniPosts].map((post) => (
                  <div class="mini-post">
                    <div class="post-head"><i class={`avatar art-${post.art}`}></i><span>@{post.handle}</span></div>
                    <div class={`post-art art-${post.art}`}></div>
                  </div>
                ))}
              </div>
            </div>
            <div class="lock" data-hero-lock>
              <span class="tile tile-ig lock-tile">I</span>
              <strong class="lock-app">Instagram</strong>
              <span class="lock-msg">{c.phone.locked}</span>
              <span class="lock-rule"></span>
              <p class="lock-quote">{heroQuote.q}</p>
              <span class="lock-cite">{heroQuote.a}</span>
              <span class="lock-back">{c.phone.back}</span>
            </div>
          </div>
        </div>
        <div class="chip chip-friend">
          <span class="ring ring-gold"><span>{n1.slice(0, 1)}</span></span>
          <span class="chip-text">{toast}</span>
          <i class="dot-ok"></i>
        </div>
        <div class="chip chip-streak">
          <svg class="streak-ring" viewBox="0 0 44 44"><circle cx="22" cy="22" r="18" class="track" /><circle cx="22" cy="22" r="18" class="fill" /></svg>
          <span class="streak-num">12</span>
          <span class="chip-text">{c.phone.streak}</span>
        </div>
      </div>
    </div>
  </section>

  <!-- DENE: ziyaretçi kilidi kendisi tetikler -->
  <section class="trial" id="dene">
    <div class="container trial-grid">
      <div class="trial-copy">
        <h2>{c.demo.title}</h2>
        <p>{c.demo.lead}</p>
        <div class="trial-actions">
          <button type="button" class="btn-ink" data-trial-auto>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4v13m0 0-5-5m5 5 5-5M5 20h14" /></svg>
            {c.demo.auto}
          </button>
          <button type="button" class="btn-line" data-trial-reset disabled>{c.demo.reset}</button>
        </div>
        <p class="trial-after">{c.demo.after}</p>
      </div>

      <div class="trial-device">
        <div class="phone" data-trial data-quotes={JSON.stringify(c.quotes.items)} data-locked-text={c.phone.locked}>
          <div class="screen">
            <div class="trial-bar">
              <div class="trial-bar-row">
                <span class="tile tile-ig small">I</span>
                <span class="trial-bar-label">{c.demo.remaining}</span>
                <strong data-trial-clock>0:15</strong>
              </div>
              <div class="meter meter-live"><span data-trial-meter></span></div>
            </div>
            <div class="feed" data-trial-feed tabindex="0" role="region" aria-label={c.demo.hint}>
              {feedPosts.map((post) => (
                <article class="post">
                  <div class="post-head"><i class={`avatar art-${post.art}`}></i><span>@{post.handle}</span></div>
                  <div class={`post-art art-${post.art}`}></div>
                  <div class="post-actions" aria-hidden="true">
                    <svg viewBox="0 0 24 24"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10Z" /></svg>
                    <svg viewBox="0 0 24 24"><path d="M20 12a8 8 0 0 1-11.6 7.1L4 20l.9-4.4A8 8 0 1 1 20 12Z" /></svg>
                    <svg viewBox="0 0 24 24"><path d="m21 3-9.5 9.5M21 3l-6.5 18-3-8.5L3 9.5 21 3Z" /></svg>
                    <span>{post.likes}</span>
                  </div>
                  <div class="post-lines" aria-hidden="true"><i></i><i></i></div>
                </article>
              ))}
            </div>
            <div class="lock" data-trial-lock>
              <span class="tile tile-ig lock-tile">I</span>
              <strong class="lock-app">Instagram</strong>
              <span class="lock-msg">{c.phone.locked}</span>
              <span class="lock-rule"></span>
              <p class="lock-quote" data-trial-quote>{c.quotes.items[0].q}</p>
              <span class="lock-cite" data-trial-cite>{c.quotes.items[0].a}</span>
              <span class="lock-back">{c.phone.back}</span>
            </div>
          </div>
        </div>
        <p class="trial-hint" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M12 3v18m0-18-4 4m4-4 4 4m-4 14-4-4m4 4 4-4" /></svg>
          {c.demo.hint}
        </p>
        <p class="sr-only" aria-live="polite" data-trial-live></p>
      </div>
    </div>
  </section>

  <!-- SOCIAL: birlikte hesap verebilirlik -->
  <section class="social" id="social">
    <div class="container social-grid">
      <div class="social-copy">
        <p class="product-mark"><img src="/logo.png" alt="" width="28" height="28" />Limitra Social</p>
        <h2>{c.social.title}</h2>
        <p class="social-lead">{c.social.lead}</p>
        <dl class="points">
          {c.social.points.map((point) => (
            <div>
              <dt>{point.t}</dt>
              <dd>{point.d}</dd>
            </div>
          ))}
        </dl>
        <a href={SOCIAL_STORE_URL} target="_blank" rel="noopener noreferrer" class="play">
          <svg class="play-glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3.8v16.4c0 .8.9 1.3 1.6.9l13-8.2c.6-.4.6-1.4 0-1.8l-13-8.2C6.9 2.5 6 3 6 3.8Z" /></svg>
          <span>{c.hero.cta}</span>
        </a>
      </div>

      <div class="friends" aria-hidden="true">
        <div class="friends-head">
          <strong>{c.social.screenTitle}</strong>
          <span>{c.social.screenSub}</span>
        </div>
        <ul class="friends-list">
          {friends.map((f) => (
            <li class={`friend is-${f.status}`}>
              <span class={`ring ring-${f.frame}`}><span>{f.name.slice(0, 1)}</span></span>
              <div class="friend-main">
                <div class="friend-top">
                  <strong>{f.name}</strong>
                  <span class={`status status-${f.status}`}>{statusLabel[f.status]}</span>
                </div>
                <div class="friend-usage">
                  <span>{f.app}</span>
                  <span>{f.used}/{f.limit} {c.social.min}</span>
                </div>
                <div class="friend-meter"><span style={`--w:${Math.min(f.used / f.limit, 1) * 100}%`}></span></div>
              </div>
              <div class="friend-best"><strong>{f.best}</strong><span>{c.social.days}</span></div>
            </li>
          ))}
        </ul>
        <div class="friends-id">
          <span>{c.social.idLabel}</span>
          <strong>#52917463</strong>
          <svg viewBox="0 0 24 24"><rect x="8" y="8" width="12" height="12" rx="2.5" /><path d="M16 8V6.5A2.5 2.5 0 0 0 13.5 4h-7A2.5 2.5 0 0 0 4 6.5v7A2.5 2.5 0 0 0 6.5 16H8" /></svg>
        </div>
      </div>
    </div>
  </section>

  <!-- SÖZLER + ortak çekirdek -->
  <section class="quotes">
    <div class="container">
      <figure class="quote-stage" data-quotes-rotator>
        {c.quotes.items.map((item, i) => (
          <blockquote class:list={['quote', { 'is-active': i === 0 }]} data-quote={i}>
            <p>{item.q}</p>
            <cite>{item.a}</cite>
          </blockquote>
        ))}
      </figure>
      <div class="quote-dots">
        {c.quotes.items.map((item, i) => (
          <button type="button" class:list={['quote-dot', { 'is-active': i === 0 }]} data-quote-dot={i} aria-label={`${item.a}: ${item.q}`} aria-pressed={i === 0 ? 'true' : 'false'}></button>
        ))}
      </div>
      <p class="quotes-caption">{c.quotes.caption}</p>

      <div class="core">
        <h2>{c.core.title}</h2>
        <ul class="core-list">
          {c.core.items.map((item) => (
            <li><strong>{item.t}</strong><span>{item.d}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- APP BLOCK: ışıkları kapat -->
  <section class="night" id="app-block">
    <div class="container night-grid">
      <div class="night-copy">
        <p class="product-mark"><img src="/logo.png" alt="" width="28" height="28" />Limitra App Block</p>
        <h2>{c.block.title}</h2>
        <p class="night-lead">{c.block.lead}</p>
        <dl class="ledger" data-ledger>
          {c.block.ledger.map((key, i) => (
            <div style={`--i:${i}`}>
              <dt>{key}</dt>
              <dd>{c.block.none}</dd>
            </div>
          ))}
        </dl>
        <figure class="manifest">
          <figcaption>{blockProof[lang] ?? blockProof.en}</figcaption>
          <pre dir="ltr"><code>&lt;uses-permission
    android:name="android.permission.<mark>INTERNET</mark>"
    tools:node="<mark>remove</mark>" /&gt;</code></pre>
        </figure>
        <div class="night-actions">
          <a href={BLOCK_STORE_URL} target="_blank" rel="noopener noreferrer" class="btn-gold">
            <svg class="play-glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3.8v16.4c0 .8.9 1.3 1.6.9l13-8.2c.6-.4.6-1.4 0-1.8l-13-8.2C6.9 2.5 6 3 6 3.8Z" /></svg>
            {c.block.cta}
          </a>
          <a href={r.whatIs} class="night-link">{c.block.more} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="night-visual" aria-hidden="true">
        <p class="night-quote">
          <span>{c.block.quote}</span>
          <em>{c.block.answer}</em>
        </p>
        <div class="phone phone-night">
          <div class="screen">
            <div class="statusbar"><span>23:14</span><span class="status-dots"><i></i><i></i><i></i></span></div>
            <div class="night-lock">
              <span class="night-brand">Limitra App Block</span>
              <span class="tile tile-yt lock-tile">Y</span>
              <strong class="lock-app">YouTube</strong>
              <span class="lock-msg">{c.phone.locked}</span>
              <span class="lock-rule"></span>
              <p class="lock-quote">{nightQuote.q}</p>
              <span class="lock-cite">{nightQuote.a}</span>
              <span class="lock-back">{c.phone.back}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- KARŞILAŞTIRMA -->
  <section class="compare">
    <div class="container">
      <h2>{c.compare.title}</h2>
      <table class="cmp">
        <thead>
          <tr>
            <td></td>
            <th scope="col"><span class="cmp-app cmp-social">Limitra Social</span></th>
            <th scope="col"><span class="cmp-app cmp-block">Limitra App Block</span></th>
          </tr>
        </thead>
        <tbody>
          {c.compare.rows.map((row) => (
            <tr>
              <th scope="row">{row.k}</th>
              {[row.s, row.b].map((cell) => (
                <td>
                  {cell === true ? (
                    <span class="mark mark-yes"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg><span class="sr-only">{c.compare.yes}</span></span>
                  ) : cell === false ? (
                    <span class="mark mark-no"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 12h10" /></svg><span class="sr-only">{c.compare.no}</span></span>
                  ) : (
                    cell
                  )}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
      <div class="cmp-actions">
        <a href={SOCIAL_STORE_URL} target="_blank" rel="noopener noreferrer" class="cmp-cta cmp-cta-social">{c.compare.ctaS}</a>
        <a href={BLOCK_STORE_URL} target="_blank" rel="noopener noreferrer" class="cmp-cta cmp-cta-block">{c.compare.ctaB}</a>
      </div>
    </div>
  </section>

  <!-- SSS -->
  <section class="faq">
    <div class="container faq-grid">
      <h2>{c.faq.title}</h2>
      <div class="faq-list">
        {c.faq.items.map((item, i) => (
          <details open={i === 0}>
            <summary>{item.q}<span class="faq-icon" aria-hidden="true"></span></summary>
            <p>{item.a}</p>
          </details>
        ))}
        <a href={r.faq} class="faq-more">{t.nav.faq} <span class="arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- HABERLER -->
  {leadNews && (
    <section class="news">
      <div class="container">
        <div class="news-head">
          <h2>{t.newsHome.title}</h2>
          <a href={r.news} class="news-all">{t.newsHome.allNews} <span class="arrow" aria-hidden="true">→</span></a>
        </div>
        <div class="news-grid">
          <article class="news-lead">
            <div class="news-meta"><span>{leadNews.category}</span><time>{leadNews.date}</time></div>
            <h3><a href={r.newsItem(leadNews.slug)}>{leadNews.title}</a></h3>
            <p>{leadNews.summary}</p>
            <span class="news-source">{leadNews.source}</span>
          </article>
          <div class="news-side">
            {sideNews.map((item) => (
              <article class="news-item">
                <div class="news-meta"><span>{item.category}</span><time>{item.date}</time></div>
                <h3><a href={r.newsItem(item.slug)}>{item.title}</a></h3>
                <span class="news-source">{item.source}</span>
              </article>
            ))}
          </div>
        </div>
        {guides.length > 0 && (
          <div class="guides">
            <div class="guides-head">
              <h3>{t.guides.title}</h3>
              <a href={r.guides}>{t.guides.allGuides} <span class="arrow" aria-hidden="true">→</span></a>
            </div>
            <ul>
              {guides.map((g) => (
                <li><a href={g.href}><span class="guide-title">{g.title}</span><span class="guide-meta">{g.meta}</span></a></li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- SON ÇAĞRI -->
  <section class="final">
    <div class="container final-inner">
      <h2>{c.final.title}</h2>
      <p>{c.final.lead}</p>
      <a href={SOCIAL_STORE_URL} target="_blank" rel="noopener noreferrer" class="play play-lg">
        <svg class="play-glyph" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3.8v16.4c0 .8.9 1.3 1.6.9l13-8.2c.6-.4.6-1.4 0-1.8l-13-8.2C6.9 2.5 6 3 6 3.8Z" /></svg>
        <span>{c.hero.cta}</span>
      </a>
      <a href="#app-block" class="final-alt">{c.final.alt} <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </section>
</Layout>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 1) Giriş telefonu: sayaç limite ulaşır, kilit ekranı iner, döngü tekrar başlar.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  if (hero) {
    const timeEl = hero.querySelector<HTMLElement>('[data-hero-time]');
    const meterEl = hero.querySelector<HTMLElement>('[data-hero-meter]');
    const START = 1600;
    const LIMIT = 1800;
    const fmt = (s: number) => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
    const paint = (s: number) => {
      if (timeEl) timeEl.textContent = fmt(s);
      if (meterEl) meterEl.style.transform = `scaleX(${s / LIMIT})`;
      hero.classList.toggle('is-near', s / LIMIT > 0.94);
    };

    if (reduceMotion) {
      paint(LIMIT);
      hero.classList.add('is-locked');
    } else {
      let visible = true;
      let raf = 0;
      let phaseStart = 0;
      let locked = false;
      const RUN_MS = 3800;
      const HOLD_MS = 5200;
      const tick = (now: number) => {
        if (!phaseStart) phaseStart = now;
        const elapsed = now - phaseStart;
        if (!locked) {
          const p = Math.min(elapsed / RUN_MS, 1);
          paint(START + (LIMIT - START) * p);
          if (p >= 1) {
            locked = true;
            phaseStart = now;
            hero.classList.add('is-locked');
          }
        } else if (elapsed > HOLD_MS) {
          locked = false;
          phaseStart = now;
          hero.classList.remove('is-locked');
          paint(START);
        }
        if (visible) raf = requestAnimationFrame(tick);
      };
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting;
        cancelAnimationFrame(raf);
        if (visible) {
          phaseStart = 0;
          raf = requestAnimationFrame(tick);
        }
      }).observe(hero);
    }
  }

  // 2) Dene: kaydırma "süreyi" harcar; bitince kilit gelir.
  const trial = document.querySelector<HTMLElement>('[data-trial]');
  if (trial) {
    const feed = trial.querySelector<HTMLElement>('[data-trial-feed]')!;
    const meter = trial.querySelector<HTMLElement>('[data-trial-meter]')!;
    const clock = trial.querySelector<HTMLElement>('[data-trial-clock]')!;
    const quoteEl = trial.querySelector<HTMLElement>('[data-trial-quote]')!;
    const citeEl = trial.querySelector<HTMLElement>('[data-trial-cite]')!;
    const live = document.querySelector<HTMLElement>('[data-trial-live]');
    const autoBtn = document.querySelector<HTMLButtonElement>('[data-trial-auto]');
    const resetBtn = document.querySelector<HTMLButtonElement>('[data-trial-reset]');
    const quotes: Array<{ q: string; a: string }> = JSON.parse(trial.dataset.quotes || '[]');
    const lockedText = trial.dataset.lockedText || '';
    const BUDGET_PX = 2400;
    const SECONDS = 15;
    let used = 0;
    let last = 0;
    let locked = false;
    let quoteIndex = 0;
    let autoRaf = 0;

    const render = () => {
      const p = Math.min(used / BUDGET_PX, 1);
      meter.style.transform = `scaleX(${1 - p})`;
      clock.textContent = `0:${String(Math.ceil(SECONDS * (1 - p))).padStart(2, '0')}`;
      trial.dataset.level = p > 0.9 ? 'bad' : p > 0.66 ? 'warn' : 'ok';
    };

    const stopAuto = () => {
      cancelAnimationFrame(autoRaf);
      autoRaf = 0;
      trial.classList.remove('is-auto');
    };

    const lock = () => {
      locked = true;
      stopAuto();
      const q = quotes[quoteIndex % quotes.length];
      if (q) {
        quoteEl.textContent = q.q;
        citeEl.textContent = q.a;
      }
      quoteIndex += 1;
      trial.classList.add('is-locked');
      feed.setAttribute('tabindex', '-1');
      if (live) live.textContent = lockedText;
      if (autoBtn) autoBtn.disabled = true;
      if (resetBtn) {
        resetBtn.disabled = false;
        resetBtn.focus({ preventScroll: true });
      }
    };

    const reset = () => {
      locked = false;
      used = 0;
      trial.classList.remove('is-locked');
      feed.scrollTop = 0;
      last = 0;
      feed.setAttribute('tabindex', '0');
      if (live) live.textContent = '';
      if (autoBtn) autoBtn.disabled = false;
      if (resetBtn) resetBtn.disabled = true;
      render();
    };

    feed.addEventListener('scroll', () => {
      const delta = Math.abs(feed.scrollTop - last);
      last = feed.scrollTop;
      if (locked) return;
      used += delta;
      if (resetBtn && used > 0) resetBtn.disabled = false;
      render();
      if (used >= BUDGET_PX) lock();
    }, { passive: true });

    autoBtn?.addEventListener('click', () => {
      if (locked || autoRaf) return;
      trial.classList.add('is-auto');
      const step = () => {
        feed.scrollTop += reduceMotion ? 60 : 9;
        if (!locked) autoRaf = requestAnimationFrame(step);
      };
      autoRaf = requestAnimationFrame(step);
    });

    // Kullanıcı kendi kaydırırsa otomatik kaydırma durur.
    feed.addEventListener('wheel', stopAuto, { passive: true });
    feed.addEventListener('touchstart', stopAuto, { passive: true });
    resetBtn?.addEventListener('click', reset);
    render();
  }

  // 3) Sözler: 7 sn'de bir değişir; üstüne gelince durur.
  const rotator = document.querySelector<HTMLElement>('[data-quotes-rotator]');
  if (rotator) {
    const items = Array.from(rotator.querySelectorAll<HTMLElement>('[data-quote]'));
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-quote-dot]'));
    let index = 0;
    let timer = 0;
    const show = (i: number) => {
      index = (i + items.length) % items.length;
      items.forEach((el, n) => el.classList.toggle('is-active', n === index));
      dots.forEach((el, n) => {
        el.classList.toggle('is-active', n === index);
        el.setAttribute('aria-pressed', String(n === index));
      });
    };
    const start = () => {
      if (reduceMotion) return;
      window.clearInterval(timer);
      timer = window.setInterval(() => show(index + 1), 7000);
    };
    dots.forEach((dot, n) => dot.addEventListener('click', () => { show(n); start(); }));
    rotator.addEventListener('mouseenter', () => window.clearInterval(timer));
    rotator.addEventListener('mouseleave', start);
    start();
  }

  // 4) App Block defteri: görünür olunca satırlar sırayla "Yok" damgası alır.
  const ledger = document.querySelector<HTMLElement>('[data-ledger]');
  if (ledger) {
    if (reduceMotion || !('IntersectionObserver' in window)) {
      ledger.classList.add('is-in');
    } else {
      ledger.classList.add('is-armed');
      const io = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) {
          ledger.classList.add('is-in');
          io.disconnect();
        }
      }, { threshold: 0.4 });
      io.observe(ledger);
    }
  }
</script>

