---
import Layout from '../layouts/Layout.astro';
import { translations, type SupportedLang } from '../data/translations';
import { routes, newsByLang } from '../data/routes';
import { mockup } from '../data/mockup';

interface Props {
  lang?: SupportedLang;
}

const { lang = 'tr' } = Astro.props;
const t = translations[lang] || translations.en;
const playUrl = 'https://play.google.com/store/apps/details?id=com.gardiyan.app';

const r = routes(lang);
const m = mockup[lang] || mockup.en;
const latestNews = (newsByLang[lang] || newsByLang.en).slice(0, 3);
const newsUrl = r.news;

const steps = t.steps.items;

const guides = lang === 'tr' ? [
  { href: r.guide('ekran-suresi'), meta: '6 dk', title: 'Ekran süreni gerçekten anla', text: 'Sürekli telefon kullanımının dikkat ve günlük ritim üzerindeki etkisini gör.' },
  { href: r.guide('klasik-limitler-neden-yetmez'), meta: '5 dk', title: 'Yumuşak limitler neden yetmez?', text: 'Bir uyarının dürtü anında neden kolayca yok sayıldığını keşfet.' },
  { href: r.guide('dikkat-uyku-ve-rutinler'), meta: '7 dk', title: 'Uyku ve dikkatini koru', text: 'Yalnızca iradeye güvenmeden daha sakin akşam rutinleri kur.' }
] : [
  { href: r.guide('ekran-suresi'), meta: '6 min', title: 'Understand your screen time', text: 'See what constant phone use does to focus and daily rhythm.' },
  { href: r.guide('klasik-limitler-neden-yetmez'), meta: '5 min', title: 'Why soft limits are easy to ignore', text: 'Explore why a warning is often not enough at the moment of temptation.' },
  { href: r.guide('dikkat-uyku-ve-rutinler'), meta: '7 min', title: 'Protect sleep and attention', text: 'Build calmer evening routines without relying on willpower alone.' }
];

const pageTitles: Record<SupportedLang, { title: string; desc: string }> = {
  tr: {
    title: 'Limitra App Block | Ekran Süresini Kontrol Et, Uygulama Engelleyici ve Dijital Denge',
    desc: 'Limitra App Block ile ekran süreni kontrol et, uygulama kullanımını sınırla ve dijital alışkanlıklarını daha bilinçli şekilde yönet.'
  },
  en: {
    title: 'Limitra App Block | Screen Time Control & App Blocker',
    desc: 'Control screen time, block distracting apps, and build digital discipline with Limitra App Block.'
  },
  es: {
    title: 'Limitra App Block | Bloqueador de aplicaciones y control de tiempo de pantalla',
    desc: 'Controla el tiempo de pantalla, bloquea apps que distraen y construye disciplina digital con Limitra App Block para Android.'
  },
  fr: {
    title: 'Limitra App Block | Bloqueur d’applications et contrôle du temps d’écran',
    desc: 'Maîtrisez votre temps d’écran, bloquez les applications distrayantes et renforcez votre discipline numérique avec Limitra App Block.'
  },
  de: {
    title: 'Limitra App Block | App-Blocker und Bildschirmzeit begrenzen',
    desc: 'Kontrollieren Sie Ihre Bildschirmzeit, blockieren Sie ablenkende Apps und bauen Sie digitale Disziplin auf mit Limitra App Block.'
  },
  pt: {
    title: 'Limitra App Block | Bloqueador de aplicativos e controle de tempo de tela',
    desc: 'Controle o tempo de tela, bloqueie aplicativos distrativos e construa disciplina digital com o Limitra App Block para Android.'
  },
  it: {
    title: 'Limitra App Block | Blocco app e controllo del tempo di utilizzo',
    desc: 'Controlla il tempo di utilizzo dello smartphone, blocca le app che distraggono e crea una sana disciplina digitale con Limitra App Block.'
  },
  ar: {
    title: 'Limitra App Block | تطبيق حظر التطبيقات والتحكم في وقت الشاشة والانضباط الرقمي',
    desc: 'تحكم في وقت الشاشة، واحظر التطبيقات المشتتة، وابنِ انضباطاً رقمياً حقيقياً مع تطبيق Limitra App Block لأجهزة أندرويد.'
  },
  id: {
    title: 'Limitra App Block | Pemblokir aplikasi dan pengontrol waktu layar Android',
    desc: 'Kendalikan waktu layar, blokir aplikasi yang mengganggu, dan bangun disiplin digital yang nyata bersama Limitra App Block.'
  },
  fil: {
    title: 'Limitra App Block | App blocker at kontrol sa oras sa screen para sa Android',
    desc: 'Kontrolin ang oras sa screen, i-block ang mga nakakaabalang app, at palakasin ang iyong digital na disiplina gamit ang Limitra App Block.'
  },
  th: {
    title: 'Limitra App Block | ตัวบล็อกแอปและควบคุมเวลาหน้าจอสำหรับ Android',
    desc: 'ควบคุมเวลาหน้าจอ บล็อกแอปที่รบกวนสมาธิ และสร้างวินัยดิจิทัลอย่างยั่งยืนด้วย Limitra App Block สำหรับ Android'
  }
};

const currentMeta = pageTitles[lang] || pageTitles.en;
---

<Layout
  title={currentMeta.title}
  description={currentMeta.desc}
  lang={lang}
>
  <section class="hero">
    <div class="hero-glow glow-one"></div>
    <div class="hero-glow glow-two"></div>
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow"><span class="signal-dot"></span>{t.hero.badge}</span>
        <h1>{t.hero.h1Line1}<br /><em>{t.hero.h1Line2}</em></h1>
        <p class="hero-lead">
          {t.hero.lead}
        </p>
        <div class="hero-actions">
          <a href={playUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            <span>{t.hero.ctaPrimary}</span><span aria-hidden="true">↗</span>
          </a>
          <a href={r.howItWorks} class="text-link">{t.hero.ctaSecondary} <span aria-hidden="true">→</span></a>
        </div>
        <div class="hero-trust" aria-label="Ürün özellikleri">
          <span><i></i>{t.hero.trustOnDevice}</span>
          <span><i></i>{t.hero.trustNoAds}</span>
          <span><i></i>{t.hero.trustAndroid}</span>
        </div>
      </div>

      <div class="product-visual" aria-label={m.visualAria}>
        <div class="orbit orbit-one"></div>
        <div class="orbit orbit-two"></div>
        <div class="phone-shell">
          <div class="phone-top"><span>9:41</span><span class="phone-sensors">● ◔ ▰</span></div>
          <div class="app-head">
            <div>
              <span class="app-kicker"><img src="/logo.png" alt="" class="kicker-logo" /> LIMITRA</span>
              <strong>{m.greeting}</strong>
            </div>
            <span class="profile-dot">A</span>
          </div>
          <div class="focus-card">
            <div class="focus-top">
              <span>{m.todaysFocus}</span>
              <strong>62%</strong>
            </div>
            <div class="progress-track"><span></span></div>
            <div class="focus-bottom"><span>{m.protectedMinutes}</span><span>{m.goal}</span></div>
          </div>
          <div class="app-section-title"><strong>{m.activeLimits}</strong><span>{m.edit}</span></div>
          <div class="limit-row">
            <span class="app-icon blue">S</span>
            <div><strong>{m.socialMedia}</strong><small>{m.socialUsage}</small></div>
            <span class="time-pill">{m.socialLeft}</span>
          </div>
          <div class="limit-row">
            <span class="app-icon coral">V</span>
            <div><strong>{m.shortVideos}</strong><small>{m.videoUsage}</small></div>
            <span class="time-pill">{m.videoLeft}</span>
          </div>
          <div class="streak-card">
            <span class="streak-icon">7</span>
            <div><strong>{m.streakTitle}</strong><small>{m.streakNote}</small></div>
          </div>
          <div class="app-nav"><span class="active">●</span><span>■</span><span>◆</span></div>
        </div>
        <div class="float-card float-left"><span class="float-icon">✓</span><div><strong>{m.boundaryActive}</strong><small>{m.protectedUntil}</small></div></div>
        <div class="float-card float-right"><span class="float-number">38</span><div><strong>{m.minutesLabel}</strong><small>{m.savedToday}</small></div></div>
        <p class="visual-note">{m.visualNote}</p>
      </div>
    </div>
  </section>

  <section class="principles" aria-label={t.principles.title}>
    <div class="container principle-grid">
      <div><span>01</span><p><strong>{t.principles.p1Title}</strong>{t.principles.p1Desc}</p></div>
      <div><span>02</span><p><strong>{t.principles.p2Title}</strong>{t.principles.p2Desc}</p></div>
      <div><span>03</span><p><strong>{t.principles.p3Title}</strong>{t.principles.p3Desc}</p></div>
    </div>
  </section>

  <section class="moment-section">
    <div class="container moment-grid">
      <div class="moment-copy">
        <span class="eyebrow light"><span class="signal-dot"></span>{t.problem.kicker}</span>
        <h2>{t.problem.title}</h2>
        <p>{t.problem.desc}</p>
      </div>
      <div class="moment-card">
        <span class="moment-label">{t.problem.loopLabel}</span>
        <div class="moment-row"><strong>{t.problem.t1Time}</strong><span>{t.problem.t1Text}</span></div>
        <div class="moment-line"><i></i></div>
        <div class="moment-row"><strong>{t.problem.t2Time}</strong><span>{t.problem.t2Text}</span></div>
        <div class="moment-pause"><img src="/logo.png" alt="Limitra App Block Logo" class="moment-logo" /><span class="moment-brand">Limitra App Block</span><strong>{t.problem.pauseTitle}</strong></div>
      </div>
    </div>
  </section>

  <section class="steps-section" id="how-it-works">
    <div class="container">
      <div class="section-heading">
        <div><span class="eyebrow"><span class="signal-dot"></span>{t.steps.kicker}</span><h2>{t.steps.title}</h2></div>
        <p>{t.steps.subtitle}</p>
      </div>
      <div class="steps-grid">
        {steps.map((step) => (
          <article class="step-card">
            <span>{step.num}</span>
            <div class="step-glyph" aria-hidden="true"><i></i><i></i><i></i></div>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="feature-section">
    <div class="container feature-grid">
      <div class="feature-copy">
        <span class="eyebrow"><span class="signal-dot"></span>{t.features.kicker}</span>
        <h2>{t.features.title}</h2>
        <p>{t.features.desc}</p>
        <ul class="check-list">
          {t.features.checks.map((check) => (
            <li><span>✓</span>{check}</li>
          ))}
        </ul>
        <a href={r.howItWorks} class="text-link">{t.features.exploreBtn} <span aria-hidden="true">→</span></a>
      </div>

      <div class="insight-panel">
        <div class="panel-tabs"><span class="active">{m.tabDiscipline}</span><span>{m.tabTimeline}</span></div>
        <div class="streak-summary">
          <div><span>{m.currentStreak}</span><strong>7 <small>{m.daysUnit}</small></strong></div>
          <span class="status-ring">7</span>
        </div>
        <div class="day-grid" aria-hidden="true">
          {Array.from({ length: 21 }, (_, index) => <span class:list={{ today: index === 20, missed: index === 8 || index === 15 }}>{index + 1}</span>)}
        </div>
        <div class="panel-legend"><span><i class="done"></i>{m.legendKept}</span><span><i class="miss"></i>{m.legendMissed}</span><span><i class="current"></i>{m.legendToday}</span></div>
      </div>
    </div>
  </section>

  <section class="privacy-section">
    <div class="container privacy-card">
      <div class="privacy-mark" aria-hidden="true"><span></span></div>
      <div class="privacy-copy">
        <span class="eyebrow light"><span class="signal-dot"></span>{t.privacy.kicker}</span>
        <h2>{t.privacy.title}</h2>
        <p>{t.privacy.desc}</p>
      </div>
      <div class="privacy-points">
        <div><strong>{t.privacy.point1Title}</strong><span>{t.privacy.point1Desc}</span></div>
        <div><strong>{t.privacy.point2Title}</strong><span>{t.privacy.point2Desc}</span></div>
        <div><strong>{t.privacy.point3Title}</strong><span>{t.privacy.point3Desc}</span></div>
      </div>
    </div>
  </section>

  <!-- Dünya Basınından Gelişmeler Bölümü -->
  <section class="home-news-section">
    <div class="container">
      <div class="section-heading news-home-heading">
        <div>
          <span class="eyebrow"><span class="signal-dot"></span>{t.newsHome.kicker}</span>
          <h2>{t.newsHome.title}</h2>
        </div>
        <a href={newsUrl} class="text-link">
          {t.newsHome.allNews} <span aria-hidden="true">→</span>
        </a>
      </div>

      <div class="home-news-grid">
        {latestNews.map((item) => (
          <article class="home-news-card">
            <div class="home-news-meta">
              <span class="home-news-cat">{item.category}</span>
              <span class="home-news-date">{item.date}</span>
            </div>
            <h3>
              <a href={r.newsItem(item.slug)}>{item.title}</a>
            </h3>
            <p>{item.summary}</p>
            <div class="home-news-footer">
              <span class="home-news-source">{item.source}</span>
              <a href={r.newsItem(item.slug)} class="home-news-link">
                {t.newsHome.read} &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="guides-section">
    <div class="container">
      <div class="section-heading guides-heading">
        <div><span class="eyebrow"><span class="signal-dot"></span>{t.guides.kicker}</span><h2>{t.guides.title}</h2></div>
        <a href={r.guides} class="text-link">{t.guides.allGuides} <span aria-hidden="true">→</span></a>
      </div>
      <div class="guides-grid">
        {guides.map((guide, index) => (
          <a href={guide.href} class="guide-card">
            <div class={`guide-visual visual-${index + 1}`}><span>{String(index + 1).padStart(2, '0')}</span><i></i></div>
            <span class="guide-meta">{guide.meta}</span>
            <h3>{guide.title}</h3>
            <p>{guide.text}</p>
            <span class="guide-arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="final-cta">
    <div class="container cta-card">
      <div class="cta-orb orb-a"></div><div class="cta-orb orb-b"></div>
      <span class="eyebrow light"><span class="signal-dot"></span>{t.finalCta.kicker}</span>
      <h2>{t.finalCta.title}</h2>
      <p>{t.finalCta.desc}</p>
      <a href={playUrl} target="_blank" rel="noopener noreferrer" class="btn cta-button">{t.finalCta.btn} <span aria-hidden="true">↗</span></a>
      <small>{t.finalCta.androidNote}</small>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: clamp(4.5rem, 9vw, 8rem) 0 5rem;
    background: radial-gradient(circle at 78% 28%, rgba(93, 140, 255, .14), transparent 31%), linear-gradient(180deg, #f9faff 0%, #f5f7fc 100%);
  }

  .hero-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    pointer-events: none;
  }

  .glow-one { width: 24rem; height: 24rem; top: -12rem; left: -12rem; background: rgba(38, 103, 245, .07); }
  .glow-two { width: 18rem; height: 18rem; right: -8rem; bottom: -8rem; border: 1px solid rgba(38, 103, 245, .16); }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(420px, .92fr);
    align-items: center;
    gap: clamp(3rem, 8vw, 7rem);
  }

  .hero-grid > * {
    min-width: 0;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: .55rem;
    margin-bottom: 1.25rem;
    color: var(--accent);
    font-size: .72rem;
    font-weight: 800;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  .eyebrow.light { color: #9fbbff; }
  .signal-dot { width: .45rem; height: .45rem; border-radius: 50%; background: currentColor; box-shadow: 0 0 0 .25rem color-mix(in srgb, currentColor 14%, transparent); }

  .hero-copy h1 { max-width: 12ch; margin-bottom: 1.5rem; }
  .hero-copy h1 em { color: var(--accent); font-style: normal; }
  .hero-lead { max-width: 38rem; margin-bottom: 2rem; font-size: clamp(1.05rem, 2vw, 1.2rem); line-height: 1.72; }
  .hero-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 1.25rem; }

  .text-link { display: inline-flex; align-items: center; gap: .45rem; color: var(--text-primary); font-size: .9rem; font-weight: 700; }
  .text-link:hover { gap: .7rem; color: var(--accent); }

  .hero-trust { display: flex; flex-wrap: wrap; gap: .75rem 1.15rem; margin-top: 2rem; }
  .hero-trust span { display: inline-flex; align-items: center; gap: .45rem; color: var(--text-muted); font-size: .75rem; font-weight: 600; }
  .hero-trust i { width: .36rem; height: .36rem; border-radius: 50%; background: var(--green); }

  .product-visual { position: relative; min-height: 630px; display: grid; place-items: center; }
  .orbit { position: absolute; border: 1px solid rgba(38,103,245,.13); border-radius: 50%; }
  .orbit-one { width: 32rem; height: 32rem; }
  .orbit-two { width: 25rem; height: 25rem; border-style: dashed; }

  .phone-shell {
    position: relative;
    z-index: 2;
    width: 305px;
    min-height: 590px;
    overflow: hidden;
    border: 7px solid #0b1730;
    border-radius: 2.8rem;
    background: #f8f9fd;
    padding: .85rem 1rem 0;
    box-shadow: 0 38px 90px rgba(15, 37, 89, .22), inset 0 0 0 1px rgba(255,255,255,.5);
    transform: rotate(2.2deg);
  }

  .phone-top { display: flex; justify-content: space-between; padding: 0 .25rem .9rem; color: #0b1730; font-size: .62rem; font-weight: 800; }
  .phone-sensors { letter-spacing: .06em; }
  .app-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
  .app-head div { display: flex; flex-direction: column; }
  .app-head strong { color: var(--text-primary); font-family: var(--font-heading); font-size: 1.25rem; }
  .app-kicker { color: var(--accent); font-size: .55rem; font-weight: 800; letter-spacing: .16em; }
  .profile-dot { display: grid; width: 2rem; height: 2rem; place-items: center; border-radius: .7rem; background: var(--accent-soft); color: var(--accent); font-size: .72rem; font-weight: 800; }

  .focus-card { border-radius: 1.15rem; background: var(--surface-dark); padding: 1rem; box-shadow: 0 16px 28px rgba(9,22,47,.14); }
  .focus-top, .focus-bottom { display: flex; justify-content: space-between; align-items: center; color: white; }
  .focus-top span { font-size: .68rem; font-weight: 600; }
  .focus-top strong { font-family: var(--font-heading); font-size: 1.05rem; }
  .progress-track { height: .4rem; margin: .8rem 0 .55rem; overflow: hidden; border-radius: 1rem; background: rgba(255,255,255,.15); }
  .progress-track span { display: block; width: 62%; height: 100%; border-radius: inherit; background: linear-gradient(90deg, #5c8cff, #8dafff); }
  .focus-bottom { color: #9eabc0; font-size: .52rem; }

  .app-section-title { display: flex; justify-content: space-between; margin: 1.15rem 0 .65rem; font-size: .66rem; }
  .app-section-title span { color: var(--accent); font-weight: 700; }
  .limit-row { display: grid; grid-template-columns: 2rem 1fr auto; align-items: center; gap: .65rem; margin-bottom: .58rem; border: 1px solid var(--border-soft); border-radius: .9rem; background: white; padding: .68rem; box-shadow: 0 6px 16px rgba(22,43,78,.04); }
  .limit-row > div { display: flex; min-width: 0; flex-direction: column; }
  .limit-row strong { overflow: hidden; color: var(--text-primary); font-size: .62rem; text-overflow: ellipsis; white-space: nowrap; }
  .limit-row small { color: var(--text-muted); font-size: .48rem; }
  .app-icon { display: grid; width: 2rem; height: 2rem; place-items: center; border-radius: .65rem; color: white; font-size: .62rem; font-weight: 800; }
  .app-icon.blue { background: linear-gradient(135deg, #2868f6, #74a0ff); }
  .app-icon.coral { background: linear-gradient(135deg, #ff6b58, #ffad8f); }
  .time-pill { border-radius: 1rem; background: var(--green-soft); padding: .28rem .42rem; color: var(--green); font-size: .5rem; font-weight: 800; }

  .streak-card { display: grid; grid-template-columns: 2.2rem 1fr; align-items: center; gap: .65rem; margin-top: .85rem; border-radius: 1rem; background: linear-gradient(135deg, #e9f8f1, #f6fbf8); padding: .8rem; }
  .streak-card div { display: flex; flex-direction: column; }
  .streak-card strong { color: #137c4b; font-size: .65rem; }
  .streak-card small { color: #5c8a73; font-size: .49rem; }
  .streak-icon { display: grid; width: 2.2rem; height: 2.2rem; place-items: center; border-radius: 50%; background: var(--green); color: white; font-size: .7rem; font-weight: 800; }
  .app-nav { position: absolute; right: 0; bottom: 0; left: 0; display: flex; justify-content: space-around; border-top: 1px solid var(--border-soft); background: white; padding: .75rem 1rem 1rem; color: #a2adbe; font-size: .7rem; }
  .app-nav .active { color: var(--accent); }

  .float-card { position: absolute; z-index: 3; display: flex; align-items: center; gap: .7rem; border: 1px solid rgba(255,255,255,.8); border-radius: 1rem; background: rgba(255,255,255,.86); padding: .75rem .9rem; box-shadow: 0 16px 35px rgba(24,44,83,.14); backdrop-filter: blur(14px); }
  .float-card div { display: flex; flex-direction: column; }
  .float-card strong { color: var(--text-primary); font-size: .68rem; }
  .float-card small { color: var(--text-muted); font-size: .5rem; }
  .float-left { left: 0; top: 25%; }
  .float-right { right: -1rem; bottom: 19%; }
  .float-icon { display: grid; width: 2rem; height: 2rem; place-items: center; border-radius: 50%; background: var(--green); color: white; font-weight: 800; }
  .float-number { color: var(--accent); font-family: var(--font-heading); font-size: 1.65rem; font-weight: 700; line-height: 1; }
  .visual-note { position: absolute; right: 0; bottom: 0; margin: 0; color: var(--text-muted); font-size: .62rem; }

  .principles { border-block: 1px solid var(--border-soft); background: white; padding: 1.4rem 0; }
  .principle-grid { display: grid; grid-template-columns: repeat(3, 1fr); }
  .principle-grid > div { display: grid; grid-template-columns: auto 1fr; gap: .8rem; border-right: 1px solid var(--border-color); padding: .35rem 2rem; }
  .principle-grid > div:first-child { padding-left: 0; }
  .principle-grid > div:last-child { border-right: 0; padding-right: 0; }
