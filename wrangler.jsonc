{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Statik site: sunucu kodu yok, yalnız dist/ klasörü yayınlanır.
  "name": "limitra",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "limitra.online", "custom_domain": true },
    { "pattern": "www.limitra.online", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": { "enabled": true }
}
